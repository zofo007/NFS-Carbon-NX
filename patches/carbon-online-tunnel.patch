@@ -0,0 +1,38 @@
+// Online (fake Live) only: make the game's UDP tunnel encrypt its datagrams the way the PC game does.
+//
+// sub_82A432B8 creates the DirtySDK ProtoTunnel and sets its mode field (tunnel + 20) to 2, which sends and
+// expects the tunnel's datagram table and bodies in clear text (the 360 normally relies on the Xbox secure
+// network for that). The community PC server only accepts datagrams RC4-encrypted with the game's key, and
+// answers in RC4, so a clear datagram is dropped without a reply. Mode 0 is the tunnel's own RC4 path, present
+// and symmetric in the same code (send: sub_82A41A88, receive: sub_82A42CE0), so setting it after creation
+// makes the game's own state machine do both directions. See docs/superpowers/findings/stage5-udp-handshake.md.
+//
+// Standard edition only (the Collector's address of this function has not been matched yet).
+#include <rex/cvar.h>
+#include <rex/logging.h>
+
+#include <cstdint>
+
+#include "edition.h"
+#include CARBON_GUEST_PCH
+
+#if !defined(NFSCARBON_COLLECTORS)
+
+REXCVAR_DECLARE(bool, online_fake_live);
+
+REXCVAR_DEFINE_BOOL(online_tunnel_rc4, true, "Online",
+                    "With online_fake_live on, create the game's UDP tunnel in its encrypted mode so a PC "
+                    "community server's race transport accepts it; false keeps the console's clear mode");
+
+extern "C" void CARBON_IMP(TUNNEL_CREATE)(PPCContext& __restrict ctx, uint8_t* base);
+
+extern "C" REX_FUNC(TUNNEL_CREATE) {
+  CARBON_IMP(TUNNEL_CREATE)(ctx, base);
+  const uint32_t tunnel = ctx.r3.u32;  // the new tunnel, or 0 when it could not be created
+  if (tunnel != 0 && REXCVAR_GET(online_fake_live) && REXCVAR_GET(online_tunnel_rc4)) {
+    REX_STORE_U32(tunnel + 20, 0);
+    REXLOG_WARN("fake Live: tunnel 0x{:08X} created in the encrypted mode (was clear)", tunnel);
+  }
+}
+
+#endif
