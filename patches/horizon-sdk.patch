+void TraceOnlineCall(const char* name, const PPCContext& ctx, std::atomic<int>& count,
+                     std::atomic<int64_t>& last_logged_ms) {
+  if (!g_trace_online_calls.load(std::memory_order_relaxed)) {
+    return;
+  }
+  const int n = count.fetch_add(1);
+  if (n >= 40) {
+    // After the first 40, one line per second per export keeps a long wait visible.
+    const int64_t now_ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+                               std::chrono::steady_clock::now().time_since_epoch())
+                               .count();
