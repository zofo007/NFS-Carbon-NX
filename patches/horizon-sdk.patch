+// std::filesystem::remove_all fails on the Switch SD card for the install work folders (hardware 2026-10-24: every
+// launch left .dlc-install/<pack> behind, "DLC work folder could not be removed ... (error)", and the next install of that
+// pack then failed with ACCESS_DENIED). Fall back to deleting entry by entry with remove/unlink/rmdir and remember what
+// could not be removed.
+static std::string g_remove_failure;
+
+static void RemoveTreeManual(const std::filesystem::path& dir) {
+  for (const auto& f : rex::filesystem::ListFiles(dir)) {
+    const auto child = dir / f.name;
+    if (f.type == rex::filesystem::FileInfo::Type::kDirectory) {
+      RemoveTreeManual(child);
+      continue;
+    }
+    std::error_code ec;
+    if (!std::filesystem::remove(child, ec) || ec) {
+      const auto native = child.string();
+      if (::unlink(native.c_str()) != 0) g_remove_failure = fmt::format("{}: errno {}", native, errno);
+    }
+  }
+  std::error_code ec;
+  if (!std::filesystem::remove(dir, ec) || ec) {
+    const auto native = dir.string();
+    if (::rmdir(native.c_str()) != 0) g_remove_failure = fmt::format("{}: errno {}", native, errno);
+  }
+}
+
+static bool RemoveTree(const std::filesystem::path& path, std::error_code& ec) {
+  ec.clear();
+  g_remove_failure.clear();
+  std::filesystem::remove_all(path, ec);
+  if (!ec) return true;
+  ec.clear();
+  RemoveTreeManual(path);
+  std::error_code exists_ec;
+  if (!std::filesystem::exists(path, exists_ec)) return true;
+  ec = std::make_error_code(std::errc::directory_not_empty);
+  return false;
+}
