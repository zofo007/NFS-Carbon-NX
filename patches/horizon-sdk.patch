new file mode 100644
index 0000000..3a79679
--- /dev/null
+++ b/sdk/src/core/switch_network.c
@@ -0,0 +1,32 @@
+/* Starts libnx's BSD socket service for the online trial.
+ * Called once, lazily, from the kernel layer, and only when online_fake_live and online_server_host
+ * are both set. The buffers are small on purpose: the process has only a few MB of memory to spare.
+ * Returns 0 on success, otherwise the libnx result code. The outcome is remembered, so a failure
+ * (no Wi-Fi, no bsd service) is not retried. */
+#include <switch.h>
+
+unsigned int rex_switch_network_start(void) {
+    static Mutex lock;
+    static int tried;
+    static Result result;
+
+    mutexLock(&lock);
+    if (!tried) {
+        tried = 1;
+        const SocketInitConfig config = {
+            .tcp_tx_buf_size = 0x4000,
+            .tcp_rx_buf_size = 0x4000,
+            .tcp_tx_buf_max_size = 0,
+            .tcp_rx_buf_max_size = 0,
+            .udp_tx_buf_size = 0x2400,
+            .udp_rx_buf_size = 0x2400,
+            .sb_efficiency = 1,
+            .num_bsd_sessions = 3,
+            .bsd_service_type = BsdServiceType_User,
+        };
+        result = socketInitialize(&config);
+    }
+    const Result outcome = result;
+    mutexUnlock(&lock);
+    return outcome;
+}
