+  if (getaddrinfo(host.c_str(), nullptr, &hints, &found) != 0 || !found) {
+    return false;
+  }
+  bool ok = false;
+  for (addrinfo* entry = found; entry; entry = entry->ai_next) {
+    if (entry->ai_family == AF_INET) {
+      *out = reinterpret_cast<sockaddr_in*>(entry->ai_addr)->sin_addr;
+      ok = true;
+      break;
+    }
+  }
+  freeaddrinfo(found);
+  return ok;
+}
