+bool KernelState::TrackThread(XThread* thread) {
+  std::lock_guard<std::mutex> lock(thread_reaper_mutex_);
+  if (thread_reaper_stopping_) {
+    return false;
+  }
+  active_threads_.push_back(retain_object(thread));
+  return true;
+}
+
+void KernelState::RetireThread(XThread* thread) {
+  std::lock_guard<std::mutex> lock(thread_reaper_mutex_);
+  // ponytail: linear lookup among the game's few dozen threads; index only if measured.
+  auto it = std::find_if(active_threads_.begin(), active_threads_.end(),
+                         [thread](const auto& entry) { return entry.get() == thread; });
+  if (it == active_threads_.end()) {
+    REX_FATAL("Exiting thread has no completion owner");
+  }
+  retired_threads_.splice(retired_threads_.end(), active_threads_, it);
+  thread_reaper_cond_.notify_all();
+}
+
+void KernelState::ThreadReaperMain() {
+  for (;;) {
+    object_ref<XThread> thread;
+    {
+      std::unique_lock<std::mutex> lock(thread_reaper_mutex_);
+      thread_reaper_cond_.wait(lock, [this] {
+        return !retired_threads_.empty() || (thread_reaper_stopping_ && active_threads_.empty());
+      });
+      if (retired_threads_.empty()) {
+        return;
+      }
+      thread = std::move(retired_threads_.front());
+      retired_threads_.pop_front();
+    }
+    if (thread->thread() &&
+        rex::thread::Wait(thread->thread(), false) != rex::thread::WaitResult::kSuccess) {
+      REX_FATAL("Failed to join completed guest thread");
+    }
+    // Release the running handle and owner only after the trampoline is gone.
+    thread->ReleaseHandle();
+  }
+}
+
+void KernelState::StopThreadReaper() {
+  if (!thread_reaper_) {
+    return;
+  }
+  terminating_title_.store(true, std::memory_order_release);
+  // A guest may be paused while holding the kernel, reaper, or object locks.
+  // The registry mutex itself cannot be held by a thread paused by this shim.
+  if (!RexSwitchSetThreadSuspensionEnabled(false)) {
+    REX_FATAL("Unable to resume paused threads for kernel teardown");
+  }
+  std::vector<object_ref<XThread>> threads;
+  {
+    std::lock_guard<std::mutex> lock(thread_reaper_mutex_);
+    thread_reaper_stopping_ = true;
+    threads.assign(active_threads_.begin(), active_threads_.end());
+  }
+  for (auto& thread : threads) {
+    if (thread->is_guest_thread() && thread->host_thread_ready()) {
+      thread->thread()->QueueUserCallback([] {});
+      uint32_t previous = 0;
+      while (thread->Resume(&previous) == X_STATUS_SUCCESS && previous > 1) {}
+      // Also release startup/native suspensions, including creation in progress.
+      while (thread->thread()->Resume()) {}
+    }
+  }
+  SignalAllWaitableObjects();
+  thread_reaper_cond_.notify_all();
+  if (rex::thread::Wait(thread_reaper_.get(), false, std::chrono::milliseconds(500)) !=
+      rex::thread::WaitResult::kSuccess) {
+    REXSYS_WARN("Waiting for live threads before destroying kernel state");
+    rex::thread::Wait(thread_reaper_.get(), false);
+  }
+  thread_reaper_.reset();
+}
