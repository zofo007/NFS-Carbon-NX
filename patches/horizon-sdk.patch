diff --git a/sdk/include/rex/system/tail_call_thunk.h b/sdk/include/rex/system/tail_call_thunk.h
new file mode 100644
index 0000000..62fe8f2
--- /dev/null
+++ b/sdk/include/rex/system/tail_call_thunk.h
@@ -0,0 +1,96 @@
+#pragma once
+/**
+ * Short guest functions that only compute a jump target and tail-call it, such as:
+ *
+ *   virtual call:  lwz r12,0(r3); lwz r11,68(r12); mtctr r11; bctr
+ *   adjustor:      lwz r10,4(r3); lwz r11,12(r3); lwz r9,8(r3); add r3,r11,r10; mtctr r9; bctr
+ *
+ * The recompiler only registers a function it finds a direct call to. These thunks are reached
+ * through vtables and delegate tables, so about 250 in the game were never registered and the
+ * first indirect call into one stopped the game. The dispatcher uses RunTailCallThunk to execute
+ * such a function from the guest code itself.
+ *
+ * Only a straight run of loads, adds, moves and immediate arithmetic that ends in `mtctr; bctr` is
+ * accepted, and only on r0-r12 (the volatile registers a caller does not expect to survive).
+ * Anything else, including stores and branches, is refused so the caller can stop as before.
+ *
+ * Header-only and free of kernel dependencies so it can be unit-tested on the host.
+ */
+
+#include <cstddef>
+#include <cstdint>
+
+namespace rex::system {
+
+constexpr size_t kMaxTailCallThunkWords = 16;
+constexpr int kTailCallThunkRegisters = 13;  // r0-r12
+
+// Runs `code_size` bytes of big-endian guest code against `regs` (r0-r12, updated in place).
+// `load32(address)` reads a guest word. On success sets *target (the value of ctr) and returns true;
+// on anything unsupported returns false, leaving `regs` partly updated (callers use a copy).
+template <typename Load32>
+bool RunTailCallThunk(const uint8_t* code, size_t code_size, uint64_t* regs, Load32&& load32,
+                      uint32_t* target) {
+  constexpr uint32_t kBctr = 0x4E800420;
+  uint64_t ctr = 0;
+  bool ctr_set = false;
+  const size_t words = code_size / 4 < kMaxTailCallThunkWords ? code_size / 4 : kMaxTailCallThunkWords;
+  for (size_t i = 0; i < words; ++i) {
+    const uint8_t* p = code + i * 4;
+    const uint32_t w = (uint32_t{p[0]} << 24) | (uint32_t{p[1]} << 16) | (uint32_t{p[2]} << 8) |
+                       uint32_t{p[3]};
+    if (w == kBctr) {
+      if (!ctr_set) return false;
+      *target = static_cast<uint32_t>(ctr);
+      return true;
+    }
+    const uint32_t op = w >> 26;
+    const uint32_t rt = (w >> 21) & 31;  // rt, or rs for the store-form encodings below
+    const uint32_t ra = (w >> 16) & 31;
+    const uint32_t rb = (w >> 11) & 31;
+    const int64_t d = static_cast<int16_t>(w & 0xFFFF);
+    const auto base_of = [&](uint32_t reg) -> uint64_t { return reg == 0 ? 0 : regs[reg]; };
+    // Every form below names its registers in these fields (mtctr keeps 9 in `ra`); r13 and up
+    // (small-data base, stack) are not modelled.
+    if (rt >= kTailCallThunkRegisters || ra >= kTailCallThunkRegisters) {
+      return false;
+    }
+    switch (op) {
+      case 32: {  // lwz rt,d(ra)
+        regs[rt] = load32(static_cast<uint32_t>(base_of(ra)) + static_cast<uint32_t>(d));
+        break;
+      }
+      case 14:  // addi rt,ra,d
+        regs[rt] = base_of(ra) + static_cast<uint64_t>(d);
+        break;
+      case 15:  // addis rt,ra,d
+        regs[rt] = base_of(ra) + static_cast<uint64_t>(d * 65536);
+        break;
+      case 24:  // ori ra,rs,imm
+        regs[ra] = regs[rt] | (w & 0xFFFF);
+        break;
+      case 31: {
+        const uint32_t xo = (w >> 1) & 0x3FF;
+        if ((w & 1) != 0) return false;  // Rc: no condition register updates
+        if (xo == 266 && (w & 0x400) == 0) {  // add rt,ra,rb
+          if (rb >= kTailCallThunkRegisters) return false;
+          regs[rt] = regs[ra] + regs[rb];
+        } else if (xo == 444) {  // or ra,rs,rb (mr when rs == rb)
+          if (rb >= kTailCallThunkRegisters) return false;
+          regs[ra] = regs[rt] | regs[rb];
+        } else if (xo == 467 && (((w >> 16) & 31) | (((w >> 11) & 31) << 5)) == 9) {  // mtctr rs
+          ctr = regs[rt];
+          ctr_set = true;
+        } else {
+          return false;
+        }
+        break;
+      }
+      default:
+        return false;
+    }
+  }
+  return false;
+}
+
+}  // namespace rex::system
diff --git a/sdk/include/rex/system/xam/fake_live.h b/sdk/include/rex/system/xam/fake_live.h
new file mode 100644
index 0000000..ea078bf
--- /dev/null
+++ b/sdk/include/rex/system/xam/fake_live.h
@@ -0,0 +1,257 @@
+#pragma once
+
+// Values the kernel reports when the profile is made to look signed in to Xbox Live.
+// Pure functions only, no kernel state, so tests/fake_live_test.cpp can compile it on its own.
+
+#include <rex/filesystem/atomic_file.h>
+
+#include <array>
+#include <cerrno>
+#include <cstdint>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <random>
+#include <string_view>
+#include <system_error>
+
+namespace rex::system::xam::fake_live {
+
+constexpr uint32_t kSigninLocal = 1;
+constexpr uint32_t kSigninLive = 2;
+constexpr uint32_t kNatOpen = 1;
+
+// XPRIVILEGE_COMMUNICATIONS_FRIENDS_ONLY: granting it restricts the user, so it stays denied.
+constexpr uint32_t kPrivilegeFriendsOnly = 251;
+
+inline uint32_t SigninState(bool live) {
+  return live ? kSigninLive : kSigninLocal;
+}
+
+inline uint32_t PrivilegeValue(bool live, uint32_t privilege_id) {
+  return live && privilege_id != kPrivilegeFriendsOnly ? 1 : 0;
+}
+
+// XNET_ETHERNET_LINK_ACTIVE | _100MBPS | _FULL_DUPLEX
+inline uint32_t EthernetLinkStatus(bool live) {
+  return live ? (0x01 | 0x02 | 0x08) : 0;
+}
+
+// XNET_GET_XNADDR_STATIC, plus ETHERNET | GATEWAY | DNS | ONLINE when live.
+inline uint32_t XnAddrStatus(bool live) {
+  return live ? (0x04 | 0x02 | 0x20 | 0x40 | 0x80) : 0x04;
+}
+
+struct Identity {
+  uint64_t xuid;
+  char gamertag[16];
+  uint8_t mac[6];
+  uint64_t machine_id;
+};
+
+// XNDNS::status values: 0 once the lookup finished, otherwise a WSA error (WSAHOST_NOT_FOUND).
+constexpr int32_t kDnsOk = 0;
+constexpr int32_t kDnsHostNotFound = 11001;
+
+// True for `ea.com` and any name below it, ignoring ASCII case: the names the game uses for EA's
+// services, which online_server_host stands in for.
+inline bool IsEaServiceHost(std::string_view host) {
+  constexpr std::string_view kDomain = "ea.com";
+  if (host.size() < kDomain.size()) {
+    return false;
+  }
+  const std::string_view tail = host.substr(host.size() - kDomain.size());
+  for (size_t i = 0; i < kDomain.size(); ++i) {
+    const char c = tail[i] >= 'A' && tail[i] <= 'Z' ? static_cast<char>(tail[i] + 32) : tail[i];
+    if (c != kDomain[i]) {
+      return false;
+    }
+  }
+  return host.size() == kDomain.size() || host[host.size() - kDomain.size() - 1] == '.';
+}
+
+namespace detail {
+
+constexpr bool StartsWith(std::string_view text, std::string_view prefix) {
+  return text.size() >= prefix.size() && text.substr(0, prefix.size()) == prefix;
+}
+
+}  // namespace detail
+
+// Names of the kernel exports worth tracing on a hardware run with the fake on: networking and
+// user/session/notification calls, not content or file I/O.
+constexpr bool IsOnlineCallName(std::string_view name) {
+  constexpr std::string_view kPrefixes[] = {
+      "__imp__NetDll_",    "__imp__XNet",        "__imp__XNotify",     "__imp__XUser",
+      "__imp__XOnline",    "__imp__XLive",       "__imp__XSession",    "__imp__XamUser",
+      "__imp__XamShow",    "__imp__XamNotify",   "__imp__XamEnumerate", "__imp__XamSession",
+      "__imp__XamVoice",   "__imp__XamParty",    "__imp__XamLoader",   "__imp__XMsg",
+  };
+  for (const std::string_view prefix : kPrefixes) {
+    if (detail::StartsWith(name, prefix)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+struct Notification {
+  uint32_t id;
+  uint32_t param;
+};
+
+// What a signed-in, Live-connected console has already told every title that listens: the first user
+// is signed in (XN_SYS_SIGNINCHANGED, a bitmask of users), the Live connection is established
+// (XN_LIVE_CONNECTIONCHANGED with XONLINE_S_LOGON_CONNECTION_ESTABLISHED) and the link is up
+// (XN_LIVE_LINK_STATE_CHANGED). The game waits for these before it looks up a server, and a new
+// listener only receives what is queued after it exists, so each new listener gets them at creation.
+// Values are from memory of the Xbox 360 SDK headers; the hardware run is what confirms them.
+inline std::array<Notification, 3> InitialNotifications() {
+  return {{{0x0000000A, 1}, {0x02000001, 0x001510F0}, {0x02000003, 1}}};
+}
+
+// The service id the game asks XOnlineGetServiceInfo for when it looks for EA's online service
+// (seen on hardware: XLiveBase message 0x58007 with 0x45410004), and the port of EA's FESL login.
+constexpr uint32_t kEaServiceId = 0x45410004;
+constexpr uint16_t kEaServicePort = 18210;
+
+// XONLINE_SERVICE_INFO as the guest reads it: service id (big-endian 32 bit), IPv4 address in
+// network order, port (big-endian 16 bit), reserved 16 bits = 0. `ipv4_host_order` is the address
+// as a plain integer (192.168.0.1 = 0xC0A80001).
+inline std::array<uint8_t, 12> EncodeServiceInfo(uint32_t service_id, uint32_t ipv4_host_order,
+                                                 uint16_t port) {
+  std::array<uint8_t, 12> bytes{};
+  for (int i = 0; i < 4; ++i) {
+    bytes[i] = static_cast<uint8_t>(service_id >> (24 - 8 * i));
+    bytes[4 + i] = static_cast<uint8_t>(ipv4_host_order >> (24 - 8 * i));
+  }
+  bytes[8] = static_cast<uint8_t>(port >> 8);
+  bytes[9] = static_cast<uint8_t>(port);
+  return bytes;
+}
+
+// XNET_CONNECT_STATUS_*: what XNetGetConnectStatus reports for a secure-address connection.
+constexpr uint32_t kConnectIdle = 0;
+constexpr uint32_t kConnectPending = 1;
+constexpr uint32_t kConnectConnected = 2;
+constexpr uint32_t kConnectLost = 3;
+
+// The Winsock error code a caller sees for a native errno from connect: the game's sockets are
+// non-blocking, so "in progress" must read as WSAEINPROGRESS/WSAEWOULDBLOCK, not a generic failure.
+inline uint32_t WinsockErrorFromErrno(int native_errno) {
+  switch (native_errno) {
+    case EINPROGRESS:
+      return 10036;  // WSAEINPROGRESS
+    case EALREADY:
+      return 10037;  // WSAEALREADY
+    case ECONNREFUSED:
+      return 10061;  // WSAECONNREFUSED
+    case ETIMEDOUT:
+      return 10060;  // WSAETIMEDOUT
+    case ENETUNREACH:
+      return 10051;  // WSAENETUNREACH
+    case EHOSTUNREACH:
+      return 10065;  // WSAEHOSTUNREACH
+    case EISCONN:
+      return 10056;  // WSAEISCONN
+    case ENOTCONN:
+      return 10057;  // WSAENOTCONN
+    case ECONNRESET:
+      return 10054;  // WSAECONNRESET
+    case ECONNABORTED:
+      return 10053;  // WSAECONNABORTED
+    default:
+      break;
+  }
+  if (native_errno == EWOULDBLOCK) {
+    return 10035;  // WSAEWOULDBLOCK
+  }
+  return 10050;  // WSAENETDOWN
+}
+
+// Address the title reports for itself: 10.0.0.2 (host order), Live's usual port 3074.
+constexpr uint32_t kFakeIpv4 = 0x0A000002;
+constexpr uint16_t kFakeOnlinePort = 3074;
+
+// The 20-byte XNADDR::abOnline: the machine id (little-endian) followed by zeros.
+inline std::array<uint8_t, 20> OnlineId(const Identity& id) {
+  std::array<uint8_t, 20> bytes{};
+  for (int i = 0; i < 8; ++i) {
+    bytes[i] = static_cast<uint8_t>(id.machine_id >> (8 * i));
+  }
+  return bytes;
+}
+
+namespace detail {
+
+inline uint64_t Mix(uint64_t& state) {
+  uint64_t z = (state += 0x9E3779B97F4A7C15ull);
+  z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ull;
+  z = (z ^ (z >> 27)) * 0x94D049BB133111EBull;
+  return z ^ (z >> 31);
+}
+
+}  // namespace detail
+
+inline Identity MakeIdentity(uint64_t seed) {
+  uint64_t state = seed;
+  Identity id{};
+  id.xuid = (uint64_t{0x0009} << 48) | (detail::Mix(state) & 0x0000FFFFFFFFFFFFull);
+  std::memcpy(id.gamertag, "Racer", 5);
+  uint64_t digits = detail::Mix(state) % 10000;
+  for (int i = 8; i >= 5; --i) {
+    id.gamertag[i] = static_cast<char>('0' + digits % 10);
+    digits /= 10;
+  }
+  const uint64_t mac_bits = detail::Mix(state);
+  id.mac[0] = 0x02;
+  for (int i = 1; i < 6; ++i) {
+    id.mac[i] = static_cast<uint8_t>(mac_bits >> (8 * (i - 1)));
+  }
+  id.machine_id = detail::Mix(state) | 1;
+  return id;
+}
+
+// Returns the 8-byte seed stored in `file`. A missing, unreadable or wrong-sized file gets a new
+// random nonzero seed, written back if possible; a failed write still returns the new seed.
+inline uint64_t LoadOrCreateSeed(const std::filesystem::path& file) {
+  std::error_code ec;
+  if (std::filesystem::file_size(file, ec) == 8 && !ec) {
+    std::ifstream in(file, std::ios::binary);
+    uint8_t bytes[8] = {};
+    if (in.read(reinterpret_cast<char*>(bytes), 8) && in.gcount() == 8) {
+      uint64_t seed = 0;
+      for (int i = 7; i >= 0; --i) {
+        seed = (seed << 8) | bytes[i];
+      }
+      if (seed != 0) {
+        return seed;
+      }
+    }
+  }
+
+  std::random_device device;
+  uint64_t seed = 0;
+  while (seed == 0) {
+    seed = (static_cast<uint64_t>(device()) << 32) | device();
+  }
+
+  std::filesystem::create_directories(file.parent_path(), ec);
+  auto temporary = file;
+  temporary += ".tmp";
+  {
+    std::ofstream out(temporary, std::ios::binary | std::ios::trunc);
+    uint8_t bytes[8];
+    for (int i = 0; i < 8; ++i) {
+      bytes[i] = static_cast<uint8_t>(seed >> (8 * i));
+    }
+    out.write(reinterpret_cast<const char*>(bytes), 8);
+    if (!out) {
+      return seed;
+    }
+  }
+  rex::filesystem::CommitFile(temporary, file, ec);
+  return seed;
+}
+
+}  // namespace rex::system::xam::fake_live
diff --git a/sdk/include/rex/system/xam/fesl_shim.h b/sdk/include/rex/system/xam/fesl_shim.h
new file mode 100644
index 0000000..a4e896f
--- /dev/null
+++ b/sdk/include/rex/system/xam/fesl_shim.h
@@ -0,0 +1,336 @@
+#pragma once
+/**
+ * Translation between the Xbox 360 build's online account protocol and the PC one.
+ *
+ * The 360 game talks the same line-based FESL frames as the PC game, but a few account
+ * transactions only exist on the 360 (for example acct GetUserIdsByXuids). A PC-only community
+ * server ignores them and the game waits for an answer that never comes. The shim sits on the
+ * game's connection to the server: frames it understands are answered locally, everything else
+ * goes through untouched.
+ *
+ * The 360 also creates and logs into its account with its own requests (XBL360AddAccount,
+ * XBL360Login). The PC server only knows AddAccount and Login, so the shim plays the PC client: it
+ * sends those, with a password only this console can derive, and hands the game the PC server's
+ * session key (lkey) and user id in the reply the game expects.
+ *
+ * Frame: 4-character command, 4-byte big-endian transaction word, 4-byte big-endian total length
+ * (header included), then "key=value\n" lines and a terminating NUL.
+ *
+ * Header-only and free of kernel dependencies so the logic can be unit-tested on the host.
+ */
+
+#include <cstddef>
+#include <cstdint>
+#include <map>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+namespace rex::system::xam::fesl {
+
+constexpr size_t kHeaderSize = 12;
+// A frame longer than this is not a FESL frame (the PC server refuses the same).
+constexpr size_t kMaxFrameSize = 65535;
+
+// One whole frame: header, the given "key=value\n" lines, and the closing NUL.
+inline std::string EncodeFrame(std::string_view command, uint32_t word, std::string_view lines) {
+  const uint32_t length = static_cast<uint32_t>(kHeaderSize + lines.size() + 1);
+  std::string frame;
+  frame.reserve(length);
+  frame.append(command.substr(0, 4));
+  frame.resize(4, ' ');
+  for (int shift = 24; shift >= 0; shift -= 8) {
+    frame.push_back(static_cast<char>((word >> shift) & 0xFF));
+  }
+  for (int shift = 24; shift >= 0; shift -= 8) {
+    frame.push_back(static_cast<char>((length >> shift) & 0xFF));
+  }
+  frame.append(lines);
+  frame.push_back('\0');
+  return frame;
+}
+
+// The user id the shim reports for an Xbox ID: stable, non-zero, and the same on every run.
+inline uint32_t LocalUserId(uint64_t xuid) {
+  return 100000000u + static_cast<uint32_t>(xuid % 800000000u);
+}
+
+// The password of the PC account this console creates: 12 characters (the PC server takes 1 to 16)
+// derived from a secret that never leaves the console. Not the Xbox ID or gamertag, which the
+// server sees and other players know.
+inline std::string AccountPassword(uint64_t secret) {
+  uint64_t z = secret + 0x9E3779B97F4A7C15ULL;
+  z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ULL;
+  z = (z ^ (z >> 27)) * 0x94D049BB133111EBULL;
+  z ^= z >> 31;
+  static constexpr char kAlphabet[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567";
+  std::string password;
+  for (int i = 0; i < 12; ++i) {
+    password.push_back(kAlphabet[(z >> (59 - 5 * i)) & 31]);
+  }
+  return password;
+}
+
+struct Translation {
+  std::vector<uint8_t> to_server;  // bytes to send to the real server
+  std::vector<uint8_t> to_game;    // bytes to hand to the game as if the server had sent them
+};
+
+class Shim {
+ public:
+  Shim(uint64_t own_xuid, std::string own_gamertag, uint64_t account_secret = 0)
+      : own_xuid_(own_xuid),
+        own_gamertag_(std::move(own_gamertag)),
+        password_(AccountPassword(account_secret)) {}
+
+  // Bytes the game sent. Whole frames are handled one by one; a partial frame waits for the rest.
+  Translation FromGame(const uint8_t* data, size_t size) {
+    Translation out;
+    Pump(data, size, &game_pending_, &game_passthrough_, &out.to_server,
+         [&](const uint8_t* frame, size_t length) { HandleGameFrame(frame, length, &out); });
+    return out;
+  }
+
+  // Bytes the server sent. Replies to requests the shim made itself are consumed and answered to the
+  // game in its own terms; everything else reaches the game untouched.
+  Translation FromServer(const uint8_t* data, size_t size) {
+    Translation out;
+    Pump(data, size, &server_pending_, &server_passthrough_, &out.to_game,
+         [&](const uint8_t* frame, size_t length) { HandleServerFrame(frame, length, &out); });
+    return out;
+  }
+
+ private:
+  // Which of the game's requests a job serves, and where it is.
+  enum class Stage { kAdd, kLogin };
+  struct Job {
+    uint32_t game_word = 0;
+    std::string game_txn;  // XBL360AddAccount or XBL360Login
+    std::string name;      // the PC account name
+    Stage stage = Stage::kLogin;
+    std::string login_error_code;  // set when Login failed first and AddAccount is being tried
+    std::string login_error_message;
+  };
+
+  static uint32_t ReadBigEndian32(const uint8_t* bytes) {
+    return (uint32_t{bytes[0]} << 24) | (uint32_t{bytes[1]} << 16) | (uint32_t{bytes[2]} << 8) |
+           uint32_t{bytes[3]};
+  }
+
+  // Splits a byte stream into whole frames. A stream that stops looking like frames is handed on
+  // as it is (`raw`) from then on.
+  template <typename Handler>
+  static void Pump(const uint8_t* data, size_t size, std::vector<uint8_t>* pending,
+                   bool* passthrough, std::vector<uint8_t>* raw, Handler&& handle) {
+    if (*passthrough) {
+      raw->insert(raw->end(), data, data + size);
+      return;
+    }
+    pending->insert(pending->end(), data, data + size);
+    size_t offset = 0;
+    while (pending->size() - offset >= kHeaderSize) {
+      const uint8_t* head = pending->data() + offset;
+      const size_t length = ReadBigEndian32(head + 8);
+      if (length < kHeaderSize || length > kMaxFrameSize) {
+        *passthrough = true;
+        raw->insert(raw->end(), pending->begin() + offset, pending->end());
+        pending->clear();
+        return;
+      }
+      if (pending->size() - offset < length) {
+        break;
+      }
+      handle(head, length);
+      offset += length;
+    }
+    pending->erase(pending->begin(), pending->begin() + offset);
+  }
+
+  // The value of `key` in a "key=value\n" body, empty when absent.
+  static std::string_view Field(std::string_view body, std::string_view key) {
+    size_t start = 0;
+    while (start < body.size()) {
+      size_t end = body.find('\n', start);
+      if (end == std::string_view::npos) {
+        end = body.size();
+      }
+      const std::string_view line = body.substr(start, end - start);
+      if (line.size() > key.size() && line.substr(0, key.size()) == key &&
+          line[key.size()] == '=') {
+        std::string_view value = line.substr(key.size() + 1);
+        while (!value.empty() && (value.back() == '\0' || value.back() == '\r')) {
+          value.remove_suffix(1);
+        }
+        return value;
+      }
+      start = end + 1;
+    }
+    return {};
+  }
+
+  static void Append(std::vector<uint8_t>* bytes, const std::string& frame) {
+    bytes->insert(bytes->end(), frame.begin(), frame.end());
+  }
+
+  void HandleGameFrame(const uint8_t* frame, size_t length, Translation* out) {
+    const std::string_view command(reinterpret_cast<const char*>(frame), 4);
+    const std::string_view body(reinterpret_cast<const char*>(frame) + kHeaderSize,
+                                length - kHeaderSize);
+    if (command == "acct") {
+      const std::string_view txn = Field(body, "TXN");
+      if (txn == "GetUserIdsByXuids") {
+        AnswerUserIdLookup(ReadBigEndian32(frame + 4), body, out);
+        return;
+      }
+      if (txn == "XBL360AddAccount" || txn == "XBL360Login") {
+        StartJob(ReadBigEndian32(frame + 4), std::string(txn), body, out);
+        return;
+      }
+    }
+    out->to_server.insert(out->to_server.end(), frame, frame + length);
+  }
+
+  void HandleServerFrame(const uint8_t* frame, size_t length, Translation* out) {
+    const std::string_view command(reinterpret_cast<const char*>(frame), 4);
+    const auto found = pending_.find(ReadBigEndian32(frame + 4));
+    if (command != "acct" || found == pending_.end()) {
+      out->to_game.insert(out->to_game.end(), frame, frame + length);
+      return;
+    }
+    const std::string_view body(reinterpret_cast<const char*>(frame) + kHeaderSize,
+                                length - kHeaderSize);
+    Job job = std::move(found->second);
+    pending_.erase(found);
+    Continue(std::move(job), body, out);
+  }
+
+  void StartJob(uint32_t game_word, std::string game_txn, std::string_view body, Translation* out) {
+    Job job;
+    job.game_word = game_word;
+    job.game_txn = std::move(game_txn);
+    std::string name(Field(body, "gamertag"));
+    if (name.empty()) {
+      name = own_gamertag_;
+    }
+    if (name.size() > 32) {
+      name.resize(32);
+    }
+    job.name = std::move(name);
+    if (job.game_txn == "XBL360AddAccount") {
+      SendAdd(std::move(job), out);
+    } else {
+      SendLogin(std::move(job), out);
+    }
+  }
+
+  void SendAdd(Job job, Translation* out) {
+    job.stage = Stage::kAdd;
+    const uint32_t word = next_word_++;
+    Append(&out->to_server,
+           EncodeFrame("acct", word,
+                       "TXN=AddAccount\nname=" + job.name + "\npassword=" + password_ + "\n"));
+    pending_.emplace(word, std::move(job));
+  }
+
+  void SendLogin(Job job, Translation* out) {
+    job.stage = Stage::kLogin;
+    const uint32_t word = next_word_++;
+    Append(&out->to_server,
+           EncodeFrame("acct", word,
+                       "TXN=Login\nname=" + job.name + "\npassword=" + password_ + "\n"));
+    pending_.emplace(word, std::move(job));
+  }
+
+  // The PC server answered one of the shim's own requests.
+  void Continue(Job job, std::string_view body, Translation* out) {
+    const std::string error(Field(body, "errorCode"));
+    const std::string message(Field(body, "localizedMessage"));
+    if (job.stage == Stage::kAdd) {
+      if (error.empty() || error == "160") {
+        if (!job.login_error_code.empty() && error == "160") {
+          // Login refused us and the name is taken: it belongs to someone else.
+          ReplyError(job, job.login_error_code, job.login_error_message, out);
+          return;
+        }
+        SendLogin(std::move(job), out);  // created, or already ours: the login decides
+        return;
+      }
+      ReplyError(job, error, message, out);
+      return;
+    }
+    if (error.empty() && !Field(body, "lkey").empty()) {
+      std::string lines = "TXN=" + job.game_txn + "\n";
+      for (const char* key : {"lkey", "name", "profileId", "userId", "displayName"}) {
+        const std::string_view value = Field(body, key);
+        if (!value.empty()) {
+          lines += std::string(key) + "=" + std::string(value) + "\n";
+        }
+      }
+      Append(&out->to_game, EncodeFrame("acct", job.game_word, lines));
+      return;
+    }
+    if (job.game_txn == "XBL360Login" && job.login_error_code.empty()) {
+      // Probably no account yet: create it once, then log in again.
+      job.login_error_code = error.empty() ? "101" : error;
+      job.login_error_message = message;
+      SendAdd(std::move(job), out);
+      return;
+    }
+    ReplyError(job, error.empty() ? "101" : error, message, out);
+  }
+
+  void ReplyError(const Job& job, const std::string& code, const std::string& message,
+                  Translation* out) {
+    std::string lines = "TXN=" + job.game_txn + "\n";
+    if (!message.empty()) {
+      lines += "localizedMessage=" + message + "\n";
+    }
+    lines += "errorCode=" + code + "\nerrorContainer.[]=0\n";
+    Append(&out->to_game, EncodeFrame("acct", job.game_word, lines));
+  }
+
+  // The 360 asks which user id belongs to each Xbox ID. The reply lists every requested ID under the
+  // key shapes the game's account code reads.
+  void AnswerUserIdLookup(uint32_t word, std::string_view body, Translation* out) {
+    std::vector<std::string> xuids;
+    const std::string count_text(Field(body, "xuids.[]"));
+    const size_t count = count_text.empty() ? 0 : static_cast<size_t>(std::stoul(count_text));
+    for (size_t i = 0; i < count && i < 64; ++i) {
+      const std::string_view value = Field(body, "xuids." + std::to_string(i));
+      if (!value.empty()) {
+        xuids.emplace_back(value);
+      }
+    }
+    // The game's account manager reads userIds.{<own xuid>}.userId (any int64 above zero) and goes
+    // on to XBL360Login on a hit; without it, it shows the terms and creates an account. Always
+    // answering with a hit lets the PC Login decide: an unknown account fails there and the game
+    // falls back to creating one itself.
+    std::string lines = "TXN=GetUserIdsByXuids\n";
+    lines += "userIds.[]=" + std::to_string(xuids.size()) + "\n";
+    lines += "userInfo.[]=" + std::to_string(xuids.size()) + "\n";
+    for (size_t i = 0; i < xuids.size(); ++i) {
+      const uint64_t xuid = std::stoull(xuids[i]);
+      const std::string user_id = std::to_string(LocalUserId(xuid));
+      const std::string index = std::to_string(i);
+      lines += "userIds.{" + xuids[i] + "}.userId=" + user_id + "\n";
+      lines += "userInfo." + index + ".xuid=" + xuids[i] + "\n";
+      lines += "userInfo." + index + ".userId=" + user_id + "\n";
+      lines += "userInfo." + index + ".userName=" +
+               (xuid == own_xuid_ ? own_gamertag_ : std::string("Player")) + "\n";
+    }
+    Append(&out->to_game, EncodeFrame("acct", word, lines));
+  }
+
+  uint64_t own_xuid_;
+  std::string own_gamertag_;
+  std::string password_;
+  std::vector<uint8_t> game_pending_;
+  std::vector<uint8_t> server_pending_;
+  bool game_passthrough_ = false;
+  bool server_passthrough_ = false;
+  std::map<uint32_t, Job> pending_;  // requests the shim made, by the word it used
+  uint32_t next_word_ = 0x80000100;
+};
+
+}  // namespace rex::system::xam::fesl
diff --git a/sdk/include/rex/system/xam/user_profile.h b/sdk/include/rex/system/xam/user_profile.h
index ec37017..fe12c46 100644
--- a/sdk/include/rex/system/xam/user_profile.h
+++ b/sdk/include/rex/system/xam/user_profile.h
@@ -20,6 +20,7 @@
 
 #include <rex/memory.h>
 #include <rex/stream.h>
+#include <rex/system/xam/fake_live.h>
 #include <rex/system/xtypes.h>
 
 namespace rex::system {
@@ -216,11 +217,25 @@ class UserProfile {
 
   UserProfile();
 
