+
+void KernelState::RetireThread(XThread* thread) {
+  std::lock_guard<std::mutex> lock(thread_reaper_mutex_);
+  // ponytail: linear lookup among the game's few dozen threads; index only if measured.
+  auto it = std::find_if(active_threads_.begin(), active_threads_.end(),
+                         [thread](const auto& entry) { return entry.get() == thread; });
+  if (it == active_threads_.end()) {
+    REX_FATAL("Exiting thread has no completion owner");
+  }
+  retired_threads_.splice(retired_threads_.end(), active_threads_, it);
+  thread_reaper_cond_.notify_all();
+}
+
+void KernelState::ThreadReaperMain() {
+  for (;;) {
+    object_ref<XThread> thread;
+    {
+      std::unique_lock<std::mutex> lock(thread_reaper_mutex_);
+      thread_reaper_cond_.wait(lock, [this] {
+        return !retired_threads_.empty() || (thread_reaper_stopping_ && active_threads_.empty());
+      });
+      if (retired_threads_.empty()) {
+        return;
+      }
+      thread = std::move(retired_threads_.front());
+      retired_threads_.pop_front();
+    }
+    if (thread->thread() &&
+        rex::thread::Wait(thread->thread(), false) != rex::thread::WaitResult::kSuccess) {
+      REX_FATAL("Failed to join completed guest thread");
+    }
+    // Release the running handle and owner only after the trampoline is gone.
+    thread->ReleaseHandle();
+  }
+}
