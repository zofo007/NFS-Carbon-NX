diff --git a/sdk/src/audio/xma_despertar.h b/sdk/src/audio/xma_despertar.h
new file mode 100644
index 0000000..1fd34dc
--- /dev/null
+++ b/sdk/src/audio/xma_despertar.h
@@ -0,0 +1,48 @@
+#pragma once
+
+// Carbon (audio_xma_despertar_si_duerme): the kick wakes the XMA worker only when it is asleep.
+// Measured on Carbon (e8d4, 2026-10-16): ~3,000 kicks/s cost the game's mixer thread ~20 us each
+// (540-660 ms per 10 s), mostly the wake itself; a worker that is already awake finds the marked
+// context on its next pass anyway.
+//
+// Lost-wakeup safety (Dekker): the kicker marks its context, then reads the flag; the worker sets the
+// flag, then looks for marked contexts. With a full fence on both sides at least one of them sees the
+// other, so either the worker keeps running or the kicker wakes it. Both seeing each other only costs
+// one extra pass of the worker (the auto-reset event stays signaled).
+
+#include <atomic>
+
+namespace rex::audio {
+
+class DespertarXma {
+ public:
+  // Kicker, after marking its contexts: true = signal the work event.
+  bool DebeAvisar() {
+    std::atomic_thread_fence(std::memory_order_seq_cst);
+    return dormido_.exchange(false, std::memory_order_seq_cst);
+  }
+
+  // Worker, with nothing done in its last pass: true = it may wait on the event. `hay_pendientes`
+  // reports whether any context is still marked.
+  template <typename HayPendientes>
+  bool PuedeDormir(HayPendientes hay_pendientes) {
+    dormido_.store(true, std::memory_order_seq_cst);
+    std::atomic_thread_fence(std::memory_order_seq_cst);
+    if (hay_pendientes()) {
+      dormido_.store(false, std::memory_order_relaxed);
+      return false;
+    }
+    return true;
+  }
+
+  // Worker, back from the wait (also after a timeout or another wake-up source).
+  void Despierto() { dormido_.store(false, std::memory_order_relaxed); }
+
+ private:
+  // Starts asleep: the worker may already be waiting when the option is switched on (Carbon turns it on
+  // after the worker started; hardware 19d24a38cf07 lost the first kick and hung the game's mixer).
+  // Extra signals only cost one extra worker pass.
+  std::atomic<bool> dormido_{true};
+};
+
+}  // namespace rex::audio
