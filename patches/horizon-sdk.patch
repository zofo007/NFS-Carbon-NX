+/* Newlib entropy hook, extracted from switch_libc_supplement.c.
+ * Distributed under the SDK's BSD license (see LICENSE).
+ * libnx randomGet uses a kernel-seeded ChaCha generator without a service.
+ * getentropy's contract limits a single request to 256 bytes. */
+#include <errno.h>
+#include <sys/reent.h>
+#include <switch.h>
+
+int _getentropy_r(struct _reent* r, void* buf, size_t len) {
+    if (len > 256) {
+        r->_errno = EIO;
+        return -1;
+    }
+    randomGet(buf, len);
+    return 0;
+}
