diff --git a/sdk/include/rex/kernel/xam/private.h b/sdk/include/rex/kernel/xam/private.h
index 3df4776..1d5e30b 100644
--- a/sdk/include/rex/kernel/xam/private.h
+++ b/sdk/include/rex/kernel/xam/private.h
@@ -10,15 +10,45 @@
  * @modified    Tom Clay, 2026 - Adapted for ReXGlue runtime
  */
 
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+
+#include <rex/logging.h>
 #include <rex/system/export_resolver.h>
 #include <rex/system/kernel_state.h>
 
+// Hardware-run trace for online_fake_live. The first `limit` uses of a call site are logged, then at
+// most one line per second, so polled calls stay visible over a long wait without flooding the log.
+// Warn level on purpose: it is flushed at once and survives a crash right after.
+#define FAKE_LIVE_TRACE_UP_TO(limit, ...)                                                      \
+  do {                                                                                         \
+    static std::atomic<int> trace_count{0};                                                    \
+    static std::atomic<int64_t> trace_last_ms{0};                                              \
+    bool trace_now = trace_count.fetch_add(1) < (limit);                                       \
+    if (!trace_now) {                                                                          \
+      const int64_t now_ms = std::chrono::duration_cast<std::chrono::milliseconds>(            \
+                                 std::chrono::steady_clock::now().time_since_epoch())          \
+                                 .count();                                                     \
+      int64_t last_ms = trace_last_ms.load();                                                  \
+      trace_now = now_ms - last_ms >= 1000 && trace_last_ms.compare_exchange_strong(last_ms, now_ms); \
+    }                                                                                          \
+    if (trace_now) {                                                                           \
+      REXKRNL_WARN(__VA_ARGS__);                                                               \
+    }                                                                                          \
+  } while (0)
+#define FAKE_LIVE_TRACE(...) FAKE_LIVE_TRACE_UP_TO(5, __VA_ARGS__)
+
