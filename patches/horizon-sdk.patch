diff --git a/sdk/include/rex/system/xam/xlive_async.h b/sdk/include/rex/system/xam/xlive_async.h
new file mode 100644
index 0000000..da81337
--- /dev/null
+++ b/sdk/include/rex/system/xam/xlive_async.h
@@ -0,0 +1,51 @@
+#pragma once
+/**
+ * Asynchronous Xbox Live tasks the title starts through XMsgStartIORequest on the XLiveBase app
+ * (0xFC). The message id is 0x50000 | a schema index that depends on the SDK the title was built
+ * with, so the id alone does not say which Xbox Live function it is. The buffer the title passes
+ * is a 0x28-byte message whose first word points to a 0x4C-byte task, and the task's `ordinal`
+ * names the function (for example 0x0A03 XUserFindUsers, 0x0604 XAccountGetUserInfo).
+ *
+ *   task +0x00 ordinal            +0x18 marshalled request pointer   +0x2C results pointer
+ *   task +0x1C request size       +0x30 results size                 (all big-endian words)
+ *
+ * Layout from the public xenia-canary netplay fork (xnet.h, XLIVE_ASYNC_TASK) and confirmed
+ * against the game: it stores the request size at task +0x1C before it starts the request.
+ *
+ * Pure functions only, no kernel state, so tests/fake_live_test.cpp can compile it on its own.
+ */
+
+#include <cstddef>
+#include <cstdint>
+
+namespace rex::system::xam::xlive_async {
+
+constexpr size_t kTaskSize = 0x4C;
+constexpr size_t kMessageSize = 0x28;
+
+// 0x5xxxx with bit 0x8000 clear: the 0x580xx messages (logon id, NAT type, service info...) are
+// synchronous queries with their own handlers.
+inline bool IsAsyncTaskMessage(uint32_t message) {
+  return (message & 0xFFFF8000u) == 0x00050000u;
+}
+
+struct Task {
+  uint32_t ordinal;
+  uint32_t request_ptr;
+  uint32_t request_size;
+  uint32_t results_ptr;
+  uint32_t results_size;
+};
+
+inline uint32_t ReadWord(const uint8_t* bytes) {
+  return (uint32_t{bytes[0]} << 24) | (uint32_t{bytes[1]} << 16) | (uint32_t{bytes[2]} << 8) |
+         uint32_t{bytes[3]};
+}
+
+// `task` points at kTaskSize bytes of guest memory.
+inline Task DecodeTask(const uint8_t* task) {
+  return {ReadWord(task + 0x00), ReadWord(task + 0x18), ReadWord(task + 0x1C),
+          ReadWord(task + 0x2C), ReadWord(task + 0x30)};
+}
+
+}  // namespace rex::system::xam::xlive_async
