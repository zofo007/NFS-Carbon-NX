+// Guest waits periodically reach the termination check, including non-alertable
+// timer/auto-reset waits that cannot all be released by signaling their objects.
+template <typename Wait>
+auto WaitWithTitleTermination(std::chrono::milliseconds timeout, Wait wait) {
+#if REX_PLATFORM_SWITCH
+  if (XThread::IsInThread() && XThread::GetCurrentThread()->is_guest_thread()) {
+    using clock = std::chrono::steady_clock;
+    const auto deadline = timeout == std::chrono::milliseconds::max()
+                              ? clock::time_point::max() : clock::now() + timeout;
+    for (;;) {
+      XThread::CheckTitleTermination();
+      const auto remaining = deadline == clock::time_point::max()
+                                 ? std::chrono::milliseconds(50)
+                                 : std::max(std::chrono::milliseconds::zero(),
+                                            std::chrono::ceil<std::chrono::milliseconds>(deadline - clock::now()));
+      auto result = wait(std::min(remaining, std::chrono::milliseconds(50)));
+      XThread::CheckTitleTermination();
+      const auto status = [&] {
+        if constexpr (requires { result.first; }) return result.first;
+        else return result;
+      }();
+      if (status != rex::thread::WaitResult::kTimeout || clock::now() >= deadline) {
+        return result;
+      }
+    }
+  }
+#endif
+  return wait(timeout);
+}
