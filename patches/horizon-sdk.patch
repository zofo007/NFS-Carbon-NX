+bool KernelState::TrackThread(XThread* thread) {
+  std::lock_guard<std::mutex> lock(thread_reaper_mutex_);
+  if (thread_reaper_stopping_) {
+    return false;
+  }
+  active_threads_.push_back(retain_object(thread));
