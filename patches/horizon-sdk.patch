new file mode 100644
index 0000000..6e2ade8
--- /dev/null
+++ b/sdk/src/ui/switch_hotspot_policy.h
@@ -0,0 +1,36 @@
+#pragma once
+
+#include <cstdint>
+#include <string_view>
+
+namespace rex::ui::switch_profile {
+
+enum class StackMode { kOff, kFull, kHotspots };
+
+constexpr StackMode SelectMode(bool full_flag, bool hotspot_flag) {
+  return hotspot_flag ? StackMode::kHotspots : full_flag ? StackMode::kFull : StackMode::kOff;
+}
+
+constexpr bool IsHotspotThread(std::string_view name) {
+  // Main XThread and Render XThread: the game's two frame threads (Carbon labels the render one from
+  // its frame handoff hook; its own name is an address that changes every run).
+  return name.starts_with("RWAudioCore Dac") || name.starts_with("GPU Commands") ||
+         name.starts_with("XMA Decoder") || name.starts_with("Main XThread") ||
+         name.starts_with("Render XThread") ||
+         name.starts_with("XThread");  // the game's other worker threads (AI, loading, cutscene video decode)
+}
+
+constexpr bool ShouldSample(StackMode mode, uint32_t handle, uint32_t target_handle) {
+  return handle && (mode == StackMode::kFull ||
+                    (mode == StackMode::kHotspots && target_handle == handle));
+}
+
+inline uint64_t SampleDelayNs(StackMode mode, uint32_t& sequence) {
+  if (mode == StackMode::kOff) return 100'000'000;
+  if (mode == StackMode::kFull) return 1'000'000;
+  // Vary the phase relative to the 187.5 Hz audio pump and periodic guest work.
+  sequence = sequence * 1664525u + 1013904223u;
+  return 8'000'000 + uint64_t(sequence >> 20) * 1000;
+}
+
+}  // namespace rex::ui::switch_profile
