diff --git a/sdk/include/rex/audio/xma/profile.h b/sdk/include/rex/audio/xma/profile.h
new file mode 100644
index 0000000..6fd3370
--- /dev/null
+++ b/sdk/include/rex/audio/xma/profile.h
@@ -0,0 +1,97 @@
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+
+namespace rex::audio {
+
+enum class XmaProfileStage { kEnable, kDisable, kWorkLock, kWorkBody, kCodec, kConvert, kCount };
+constexpr size_t kXmaProfileStageCount = size_t(XmaProfileStage::kCount);
+
+struct XmaProfileClock {
+  uint64_t wall_ns = 0, cpu_ns = 0;
+  bool cpu_valid = false;
+};
+
+struct XmaProfileSnapshot {
+  uint64_t calls, samples, wall_ns, wall_max_ns, cpu_ns, cpu_max_ns, cpu_samples;
+};
+
+struct XmaProfileStats {
+  std::atomic<uint64_t> calls{0}, samples{0}, wall_ns{0}, wall_max_ns{0};
+  std::atomic<uint64_t> cpu_ns{0}, cpu_max_ns{0}, cpu_samples{0};
+
+  static void Max(std::atomic<uint64_t>& target, uint64_t value) {
+    uint64_t previous = target.load(std::memory_order_relaxed);
+    while (value > previous &&
+           !target.compare_exchange_weak(previous, value, std::memory_order_relaxed)) {}
+  }
+
+  void Record(XmaProfileClock start, XmaProfileClock end) {
+    const uint64_t wall = end.wall_ns >= start.wall_ns ? end.wall_ns - start.wall_ns : 0;
+    wall_ns.fetch_add(wall, std::memory_order_relaxed);
+    Max(wall_max_ns, wall);
+    if (start.cpu_valid && end.cpu_valid && end.cpu_ns >= start.cpu_ns) {
+      const uint64_t cpu = end.cpu_ns - start.cpu_ns;
+      cpu_ns.fetch_add(cpu, std::memory_order_relaxed);
+      Max(cpu_max_ns, cpu);
+      cpu_samples.fetch_add(1, std::memory_order_relaxed);
+    }
+    samples.fetch_add(1, std::memory_order_relaxed);
+  }
+
+  XmaProfileSnapshot Take() {
+    return {calls.exchange(0, std::memory_order_relaxed),
+            samples.exchange(0, std::memory_order_relaxed),
+            wall_ns.exchange(0, std::memory_order_relaxed),
+            wall_max_ns.exchange(0, std::memory_order_relaxed),
+            cpu_ns.exchange(0, std::memory_order_relaxed),
+            cpu_max_ns.exchange(0, std::memory_order_relaxed),
+            cpu_samples.exchange(0, std::memory_order_relaxed)};
+  }
+};
+
+inline std::array<XmaProfileStats, kXmaProfileStageCount> g_xma_profile;
+inline thread_local std::array<uint32_t, kXmaProfileStageCount> g_xma_profile_sequence{};
+
+template <auto ReadClock>
+class SampledXmaProfileScope {
+ public:
+  SampledXmaProfileScope(XmaProfileStage stage, bool enabled) {
+    if (!enabled) return;
+    stats_ = &g_xma_profile[size_t(stage)];
+    stats_->calls.fetch_add(1, std::memory_order_relaxed);
+    // High LCG bits avoid repeatedly selecting the same voice in a periodic batch.
+    uint32_t& sequence = g_xma_profile_sequence[size_t(stage)];
+    sequence = sequence * 1664525u + 1013904223u;
+    sampled_ = (sequence >> 26) == 0;  // About 1/64; no clock/syscall otherwise.
+    if (sampled_) start_ = ReadClock();
+  }
+
+  ~SampledXmaProfileScope() {
+    if (sampled_) stats_->Record(start_, ReadClock());
+  }
+
+  void Next(XmaProfileStage stage) {
+    if (!stats_) return;
+    if (sampled_) {
+      const XmaProfileClock now = ReadClock();
+      stats_->Record(start_, now);
+      start_ = now;
+    }
+    stats_ = &g_xma_profile[size_t(stage)];
+    stats_->calls.fetch_add(1, std::memory_order_relaxed);
+  }
+
+  SampledXmaProfileScope(const SampledXmaProfileScope&) = delete;
+  SampledXmaProfileScope& operator=(const SampledXmaProfileScope&) = delete;
+
+ private:
+  XmaProfileStats* stats_ = nullptr;
+  XmaProfileClock start_{};
+  bool sampled_ = false;
+};
+
+}  // namespace rex::audio
