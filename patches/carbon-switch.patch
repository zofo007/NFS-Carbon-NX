diff --git a/src/render_pass_profile_hook.cpp b/src/render_pass_profile_hook.cpp
new file mode 100644
index 0000000..8a42191
--- /dev/null
+++ b/src/render_pass_profile_hook.cpp
@@ -0,0 +1,94 @@
+// Switch: time the game's own per-frame render passes, and optionally skip them (diagnostic).
+//
+// Stack capture 23:14-23:20: the game's render thread grows from 47% to 72% of a core when
+// 6 AI cars join. Its frame, read from the generated code: sub_824F0210 runs a visibility
+// prep (sub_8250B4D0 -> the per-object test sub_82586908, the thread's hottest function) and
+// five view passes; each pass walks the scene for its view (sub_825879F8) and submits it
+// (sub_82509978). Which pass is the reflection cube, mirror or shadows is not visible in the
+// code, so this measures each one's time on the game thread and can skip any of them, like
+// the MW port's race trimming (reference-nfsmw-nx/app/src/nfsmw_recortes_carrera.cpp).
+//
+// carbon_debug_skip_passes: bit 0 = prep, bits 1-5 = passes in call order. Skipping a pass
+// leaves its render targets with old contents; skipping the prep or the main pass is expected
+// to break the picture. Default 0: every original runs; only two clock reads per call.
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+
+#include "../generated/default/nfscarbon_pch.h"
+
+REXCVAR_DEFINE_INT32(carbon_debug_skip_passes, 0, "CarbonDebug",
+                     "Skip game render passes (diagnostic): bit 0 visibility prep sub_8250B4D0, bits 1-5 "
+                     "view passes sub_824EED60, sub_824EF830, sub_824EFB70, sub_824EF1A8, sub_824EE110");
+
+extern "C" void __imp__sub_824F0210(PPCContext& __restrict ctx, uint8_t* base);
+extern "C" void __imp__sub_8250B4D0(PPCContext& __restrict ctx, uint8_t* base);
+extern "C" void __imp__sub_824EED60(PPCContext& __restrict ctx, uint8_t* base);
+extern "C" void __imp__sub_824EF830(PPCContext& __restrict ctx, uint8_t* base);
+extern "C" void __imp__sub_824EFB70(PPCContext& __restrict ctx, uint8_t* base);
+extern "C" void __imp__sub_824EF1A8(PPCContext& __restrict ctx, uint8_t* base);
+extern "C" void __imp__sub_824EE110(PPCContext& __restrict ctx, uint8_t* base);
+
+namespace {
+constexpr size_t kSlots = 7;  // 0 prep, 1-5 passes, 6 whole frame (sub_824F0210)
+std::array<std::atomic<uint64_t>, kSlots> g_ns{};
+std::array<std::atomic<uint32_t>, kSlots> g_calls{};
+std::atomic<int64_t> g_report_at{0};
+
+int64_t NowNs() {
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+template <void (*Original)(PPCContext& __restrict, uint8_t*)>
+void Timed(size_t slot, PPCContext& ctx, uint8_t* base) {
+  if (slot < 6 && (REXCVAR_GET(carbon_debug_skip_passes) >> slot) & 1) {
+    g_calls[slot].fetch_add(1, std::memory_order_relaxed);
+    return;  // skipped: the game's pass does not run this frame
+  }
+  const int64_t start = NowNs();
+  Original(ctx, base);
+  g_ns[slot].fetch_add(uint64_t(NowNs() - start), std::memory_order_relaxed);
+  g_calls[slot].fetch_add(1, std::memory_order_relaxed);
+}
+
+// One line every 10 s from the game's render thread, after a whole frame.
+void MaybeReport() {
+  const int64_t now = NowNs();
+  int64_t due = g_report_at.load(std::memory_order_relaxed);
+  if (due == 0) {
+    g_report_at.store(now + 10'000'000'000, std::memory_order_relaxed);
+    return;
+  }
+  if (now < due) return;
+  g_report_at.store(now + 10'000'000'000, std::memory_order_relaxed);
+  std::array<double, kSlots> ms{};
+  const double frames = double(std::max<uint32_t>(g_calls[6].exchange(0), 1));
+  for (size_t i = 0; i < kSlots; ++i) {
+    ms[i] = double(g_ns[i].exchange(0)) * 1e-6 / frames;
+    if (i < 6) g_calls[i].exchange(0);
+  }
+  REXLOG_INFO("[render-pass] game render thread ms/frame over {:.0f} frames: prep {:.2f} | passes "
+              "EED60 {:.2f}, EF830 {:.2f}, EFB70 {:.2f}, EF1A8 {:.2f}, EE110 {:.2f} | frame {:.2f} | skip mask {}",
+              frames, ms[0], ms[1], ms[2], ms[3], ms[4], ms[5], ms[6],
+              REXCVAR_GET(carbon_debug_skip_passes));
+}
+}  // namespace
+
+extern "C" REX_FUNC(sub_8250B4D0) { Timed<__imp__sub_8250B4D0>(0, ctx, base); }
+extern "C" REX_FUNC(sub_824EED60) { Timed<__imp__sub_824EED60>(1, ctx, base); }
+extern "C" REX_FUNC(sub_824EF830) { Timed<__imp__sub_824EF830>(2, ctx, base); }
+extern "C" REX_FUNC(sub_824EFB70) { Timed<__imp__sub_824EFB70>(3, ctx, base); }
+extern "C" REX_FUNC(sub_824EF1A8) { Timed<__imp__sub_824EF1A8>(4, ctx, base); }
+extern "C" REX_FUNC(sub_824EE110) { Timed<__imp__sub_824EE110>(5, ctx, base); }
+extern "C" REX_FUNC(sub_824F0210) {
+  Timed<__imp__sub_824F0210>(6, ctx, base);
+  MaybeReport();
+}
