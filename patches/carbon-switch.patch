+#pragma once
+
+#include <cstdint>
+#include <vulkan/vulkan_core.h>
+
+namespace carbon::gpu {
+
+// Set 0 is always updated; never batch across an unbound texture-set gap.
+inline uint32_t DescriptorBindCount(VkDescriptorSet vs_set, bool vs_changed, bool ps_changed) {
+  return ps_changed && vs_set ? 3u : (vs_changed ? 2u : 1u);
+}
