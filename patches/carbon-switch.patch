+// Carbon native renderer: texture lookup in one walk of an address bucket.
+#pragma once
+
+#include <utility>
+
+namespace carbon::gpu {
+
+// Over [first, last) of (address, owning pointer) entries: the most recently used resolved
+// image when `resolvable` (ties keep the earlier one), and the first non-resolved entry whose
+// guest description equals `guest`. Same choices as FindResolvedTexture(base, 0, 0) followed by
+// a second search for the guest texture, in one pass.
+template <typename It, typename Guest>
+auto PickTexture(It first, It last, const Guest& guest, bool resolvable) {
+  using T = decltype(first->second.get());
+  T resolved = nullptr, match = nullptr;
+  for (; first != last; ++first) {
+    T e = first->second.get();
+    if (e->resolved) {
+      if (resolvable && (!resolved || e->last_used_frame > resolved->last_used_frame)) resolved = e;
+    } else if (!match && e->guest == guest) {
+      match = e;
+    }
+  }
+  return std::pair{resolved, match};
+}
+
+}  // namespace carbon::gpu
