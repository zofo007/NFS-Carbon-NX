+#pragma once
+
+#include <cstdint>
+#include <memory_resource>
+#include <vector>
+
+namespace carbon::gpu {
+
+struct VertexArenaPage {
+  uint64_t hash = 0;  // 0 = page not copied yet
+  uint64_t checked = 0;
+  uint8_t interval = 1;
+};
+
+struct VertexArenaEntry {
+  uint32_t offset = 0;  // bytes in the arena
+  uint32_t size = 0;
+  explicit VertexArenaEntry(std::pmr::memory_resource* memory = std::pmr::get_default_resource())
+      : pages(memory) {}
+  std::pmr::vector<VertexArenaPage> pages;
+};
+
+// carbon_gpu_vertex_memo: within one frame an arena fetch's page decisions cannot change (pages checked
+// this frame, or not due yet), so a fetch of a buffer already validated this frame over a covering
+// range gets the same offset without the map lookup and page walk. Invalidate() whenever an entry is
+// dropped or the arena resets.
+class VertexArenaMemo {
+ public:
+  bool Find(uint64_t key, uint64_t frame, uint32_t lo, uint32_t hi, uint32_t& dword_offset) const {
+    const Slot& s = slots_[Index(key)];
+    if (s.epoch != epoch_ || s.key != key || s.frame != frame || lo < s.lo || hi > s.hi) return false;
+    dword_offset = s.dword_offset;
+    return true;
+  }
+  void Store(uint64_t key, uint64_t frame, uint32_t lo, uint32_t hi, uint32_t dword_offset) {
+    slots_[Index(key)] = {key, frame, lo, hi, dword_offset, epoch_};
+  }
+  void Invalidate() { ++epoch_; }
+
+ private:
+  struct Slot {
+    uint64_t key = 0, frame = 0;
+    uint32_t lo = 0, hi = 0, dword_offset = 0, epoch = 0;
+  };
+  static uint32_t Index(uint64_t key) { return uint32_t((key ^ (key >> 29)) * 0x9E3779B97F4A7C15ull >> 56); }
+  Slot slots_[256];
+  uint32_t epoch_ = 1;
+};
+
+}  // namespace carbon::gpu
diff --git a/src/audio_filter_8bb0.h b/src/audio_filter_8bb0.h
new file mode 100644
index 0000000..3f58f48
--- /dev/null
+++ b/src/audio_filter_8bb0.h
@@ -0,0 +1,69 @@
+#pragma once
+
+#include "../generated/default/nfscarbon_pch.h"
+
+#include <cmath>
+
+namespace carbon::audio {
+
+// Keep the callback/prologue and aliased filter accesses; only loop register traffic is removed.
+inline void Filter8BB0(PPCContext& __restrict ctx, uint8_t* base) {
+  REX_FUNC_PROLOGUE();
+  ctx.r12.u64 = ctx.lr;
+  ctx.lr = 0x826C8BB8;
+  const uint32_t frame = ctx.r1.u32 - 128;
+  REX_STORE_U32(frame, ctx.r1.u32);
+  ctx.r1.u32 = frame;
+  const uint64_t object = ctx.r3.u64, count = ctx.r4.u64;
+  const uint64_t source = ctx.r5.u64, output = ctx.r6.u64;
+  ctx.r11.u64 = REX_LOAD_U32(uint32_t(object) + 8);
+  if (ctx.r11.u32 != 0) {
+    ctx.r3.u64 = ctx.r11.u32;
+    ctx.r7.u64 = REX_LOAD_U8(uint32_t(object) + 26);
+    ctx.r6.u64 = source;
+    ctx.r5.u64 = output;
+    ctx.r11.u64 = REX_LOAD_U32(ctx.r3.u32);
+    const uint32_t target = ctx.r11.u32;
+    ctx.lr = 0x826C8BF4;
+    REX_CALL_INDIRECT_FUNC(target);
+    if (ctx.r3.s32 <= 0) {
+      ctx.r1.s64 += 128;
+      return;
+    }
+  }
+  const uint64_t state = object + 28;
+  ctx.r9.u64 = state;
+  if (int32_t(count) > 0) {
+    uint64_t destination = output, remaining = count;
+    const uint64_t difference = source - output;
+    ctx.r8.u64 = difference;
+    ctx.fpscr.disableFlushMode();
+    PPCRegister bits{};
+    double value = 0, input = 0, input_gain = 0;
+    do {
+      bits.u32 = REX_LOAD_U32(uint32_t(state));
+      const double history = double(bits.f32);
+      --remaining;
+      bits.u32 = REX_LOAD_U32(uint32_t(state) + 4);
+      value = double(float(double(bits.f32) * history));
+      bits.u32 = REX_LOAD_U32(uint32_t(destination) + uint32_t(difference));
+      input = double(bits.f32);
+      bits.u32 = REX_LOAD_U32(uint32_t(state) + 8);
+      input_gain = double(bits.f32);
+      value = double(float(std::fma(input, input_gain, value)));
+      bits.f32 = float(value);
+      REX_STORE_U32(uint32_t(state), bits.u32);
+      REX_STORE_U32(uint32_t(destination), bits.u32);
+      destination += 4;
+    } while (uint32_t(remaining) != 0);
+    ctx.r10.u64 = remaining;
+    ctx.r11.u64 = destination;
+    ctx.f0.f64 = value;
+    ctx.f12.f64 = input_gain;
+    ctx.f13.f64 = input;
+  }
+  ctx.r3.u64 = count;
+  ctx.r1.s64 += 128;
+}
+
+}  // namespace carbon::audio
diff --git a/src/audio_filter_cca20.h b/src/audio_filter_cca20.h
new file mode 100644
index 0000000..c517381
--- /dev/null
+++ b/src/audio_filter_cca20.h
@@ -0,0 +1,155 @@
+#pragma once
+
+#include "../generated/default/nfscarbon_pch.h"
+
+#include <bit>
+#include <cmath>
+
+namespace carbon::audio {
+
+// Carbon 826CCA20: per-channel biquad over 256-sample blocks. Pass 1 filters the first two samples
+// from the saved history, pass 2 the other 254 with the anti-denormal constant at 0x820C7F28, pass 3
+// saves the new history, then the input/output block descriptors (filter+0x3000C/+0x30010) swap.
+// Same guest accesses in the same order and width (coefficients and history are reloaded because
+// the output may alias them), same FP round/FMA points and final context; only register traffic
+// moves to typed locals.
+inline void FilterCCA20(PPCContext& __restrict ctx, uint8_t* base) {
+  REX_FUNC_PROLOGUE();
+  const auto load = [base](uint64_t address) {
+    return double(std::bit_cast<float>(uint32_t(REX_LOAD_U32(uint32_t(address)))));
+  };
+  const auto store = [base](uint64_t address, double value) {
+    REX_STORE_U32(uint32_t(address), std::bit_cast<uint32_t>(float(value)));
+  };
+  // A channel's sample offset in bytes: the original's 32-bit multiply and rotate-mask.
+  const auto offset = [](uint64_t stride, uint64_t channel) {
+    return uint64_t(uint32_t(int64_t(int32_t(uint32_t(stride))) * int32_t(uint32_t(channel))) << 2);
+  };
+  ctx.r12.u64 = ctx.lr;
+  ctx.lr = 0x826CCA28;
+  uint64_t r3 = ctx.r3.u64, r4 = ctx.r4.u64, r5 = ctx.r5.u64, r7 = ctx.r7.u64, r10, r11 = ctx.r11.u64;
+  double f0 = ctx.f0.f64, f5 = ctx.f5.f64, f6 = ctx.f6.f64, f7 = ctx.f7.f64, f8 = ctx.f8.f64,
+         f9 = ctx.f9.f64, f10 = ctx.f10.f64, f11 = ctx.f11.f64, f12 = ctx.f12.f64, f13 = ctx.f13.f64;
+  const uint64_t out_desc_at = r4 + 196608 + 16, in_desc_at = r4 + 196608 + 12;
+  const uint32_t channels = ctx.r6.u32;
+  const uint64_t out_desc = REX_LOAD_U32(uint32_t(out_desc_at)), in_desc = REX_LOAD_U32(uint32_t(in_desc_at));
+  r10 = 0;
+  if (channels != 0) {
+    ctx.fpscr.disableFlushMode();  // every switch of the original is under this condition; idempotent
+    r11 = r3 + 48;
+    do {
+      r7 = REX_LOAD_U16(uint32_t(in_desc) + 14);
+      f0 = load(r5 + 8);
+      r4 = REX_LOAD_U32(uint32_t(in_desc) + 4);
+      f8 = load(r11 - 44);
+      const uint64_t in_offset = offset(r7, r10);
+      f13 = load(r5 + 16);
+      f7 = load(r11 - 48);
+      f12 = load(r5 + 12);
+      const uint64_t out_stride = REX_LOAD_U16(uint32_t(out_desc) + 14);
+      f11 = load(r11);
+      const uint64_t out_data = REX_LOAD_U32(uint32_t(out_desc) + 4);
+      f10 = load(r5);
+      f6 = load(r11 + 4);
+      f9 = load(r5 + 4);
+      r7 = in_offset + r4;
+      r4 = offset(out_stride, r10) + out_data;
+      ++r10;
+      f5 = load(r7);
+      f0 = double(float(f0 * f5));
+      f0 = double(float(std::fma(f8, f13, f0)));
+      f0 = double(float(std::fma(f7, f12, f0)));
+      f0 = double(float(-std::fma(f11, f10, -f0)));
+      f0 = double(float(-std::fma(f6, f9, -f0)));
+      store(r4, f0);
+      f0 = load(r11 - 48);
+      f13 = load(r5 + 16);
+      f0 = double(float(f0 * f13));
+      f12 = load(r5 + 8);
+      f13 = load(r7 + 4);
+      f11 = load(r5 + 12);
+      f10 = load(r7);
+      f9 = load(r5);
+      f8 = load(r4);
+      f7 = load(r11);
+      r11 += 8;
+      f6 = load(r5 + 4);
+      f0 = double(float(std::fma(f13, f12, f0)));
+      f0 = double(float(std::fma(f11, f10, f0)));
+      f0 = double(float(-std::fma(f9, f8, -f0)));
+      f0 = double(float(-std::fma(f7, f6, -f0)));
+      store(r4 + 4, f0);
+    } while (uint32_t(r10) < channels);
+  }
+  r4 = 0;
+  if (channels != 0) {
+    r11 = uint64_t(int64_t(-2113142784));
+    f0 = load(r11 + 32552);
+    do {
+      const uint64_t in_offset = offset(REX_LOAD_U16(uint32_t(in_desc) + 14), r4);
+      const uint64_t out_stride = REX_LOAD_U16(uint32_t(out_desc) + 14);
+      const uint64_t in_data = REX_LOAD_U32(uint32_t(in_desc) + 4);
+      r7 = REX_LOAD_U32(uint32_t(out_desc) + 4);
+      r10 = in_offset + in_data;
+      r7 = uint64_t(uint32_t(int64_t(int32_t(uint32_t(out_stride))) * int32_t(uint32_t(r4)) + 2) << 2) + r7;
+      r11 = r10 + 8;
+      r10 += 1024;
+      while (uint32_t(r11) < uint32_t(r10)) {
+        f13 = load(r11 - 8);
+        f12 = load(r5 + 16);
+        f13 = double(float(f13 * f12));
+        f12 = load(r11 - 4);
+        f10 = load(r5 + 12);
+        f11 = load(r11);
+        r11 += 4;
+        f9 = load(r5 + 8);
+        f8 = load(r7 - 4);
+        f7 = load(r5);
+        f6 = load(r7 - 8);
+        f5 = load(r5 + 4);
+        f13 = double(float(std::fma(f12, f10, f13)));
+        f13 = double(float(std::fma(f11, f9, f13)));
+        f13 = double(float(f13 + f0));
+        f13 = double(float(-std::fma(f8, f7, -f13)));
+        f13 = double(float(-std::fma(f6, f5, -f13)));
+        store(r7, f13);
+        r7 += 4;
+      }
+      ++r4;
+    } while (uint32_t(r4) < channels);
+  }
+  r10 = 0;
+  if (channels != 0) {
+    r11 = r3 + 52;
+    do {
+      r7 = REX_LOAD_U16(uint32_t(in_desc) + 14);
+      r3 = REX_LOAD_U16(uint32_t(out_desc) + 14);
+      r7 = offset(r7, r10);
+      r5 = REX_LOAD_U32(uint32_t(in_desc) + 4);
+      r4 = REX_LOAD_U32(uint32_t(out_desc) + 4);
+      r3 = uint64_t(int64_t(int32_t(uint32_t(r3))) * int64_t(int32_t(uint32_t(r10))));
+      r7 += r5;
+      r5 = uint64_t(uint32_t(r3) << 2) + r4;
+      ++r10;
+      f0 = load(r7 + 1016);
+      store(r11 - 48, f0);
+      f0 = load(r7 + 1020);
+      store(r11 - 52, f0);
+      f0 = load(r5 + 1016);
+      store(r11, f0);
+      f0 = load(r5 + 1020);
+      store(r11 - 4, f0);
+      r11 += 8;
+    } while (uint32_t(r10) < channels);
+  }
+  r11 = REX_LOAD_U32(uint32_t(out_desc_at));
+  r10 = REX_LOAD_U32(uint32_t(in_desc_at));
+  REX_STORE_U32(uint32_t(in_desc_at), uint32_t(r11));
+  REX_STORE_U32(uint32_t(out_desc_at), uint32_t(r10));
+  ctx.r3.u64 = r3; ctx.r4.u64 = r4; ctx.r5.u64 = r5; ctx.r7.u64 = r7; ctx.r10.u64 = r10; ctx.r11.u64 = r11;
+  ctx.r8.u64 = in_desc; ctx.r9.u64 = out_desc;
+  ctx.f0.f64 = f0; ctx.f5.f64 = f5; ctx.f6.f64 = f6; ctx.f7.f64 = f7; ctx.f8.f64 = f8; ctx.f9.f64 = f9;
+  ctx.f10.f64 = f10; ctx.f11.f64 = f11; ctx.f12.f64 = f12; ctx.f13.f64 = f13;
+}
+
+}  // namespace carbon::audio
diff --git a/src/audio_gain_fast.h b/src/audio_gain_fast.h
new file mode 100644
index 0000000..c8272aa
--- /dev/null
+++ b/src/audio_gain_fast.h
@@ -0,0 +1,68 @@
+#pragma once
+// sub_826CD528 (out = in * gain) and sub_826CD8D0 (out += in * gain): the game's VMX gain loops over
+// big-endian float blocks. Their vector path needs out and in 128-byte aligned and a count that is a
+// multiple of 64; this is the same arithmetic in a NEON loop. The VMX unit and NEON agree for finite
+// normal inputs (denormals are flushed on both with flush mode on), so a block with any NaN, infinity or
+// denormal input, a special gain, a partial overlap, or any other layout returns false and the caller runs
+// the register-local copy of the original. Tested bit-exact in tests/native_leaf_test.cpp.
+#include <simde/arm/neon.h>
+
+#include <cstdint>
+
+namespace carbon::audio {
+
+// True when no float of the big-endian block is NaN, infinity or a nonzero denormal.
+inline bool AllNormalOrZero(const uint8_t* p, uint32_t n) {
+  simde_uint32x4_t bad = simde_vdupq_n_u32(0);
+  const simde_uint32x4_t exp_mask = simde_vdupq_n_u32(0x7F800000u), man_mask = simde_vdupq_n_u32(0x007FFFFFu);
+  for (uint32_t i = 0; i < n; i += 4) {
+    const simde_uint32x4_t u = simde_vreinterpretq_u32_u8(simde_vrev32q_u8(simde_vld1q_u8(p + 4 * size_t(i))));
+    const simde_uint32x4_t e = simde_vandq_u32(u, exp_mask);
+    const simde_uint32x4_t inf_nan = simde_vceqq_u32(e, exp_mask);
+    const simde_uint32x4_t denormal = simde_vandq_u32(simde_vceqq_u32(e, simde_vdupq_n_u32(0)),
+                                                       simde_vmvnq_u32(simde_vceqq_u32(simde_vandq_u32(u, man_mask), simde_vdupq_n_u32(0))));
+    bad = simde_vorrq_u32(bad, simde_vorrq_u32(inf_nan, denormal));
+  }
+  return simde_vmaxvq_u32(bad) == 0;
+}
+
+inline bool GainNormal(float g) {
+  uint32_t u;
+  __builtin_memcpy(&u, &g, 4);
+  const uint32_t e = u & 0x7F800000u;
+  return e != 0x7F800000u && (e != 0 || (u & 0x007FFFFFu) == 0);
+}
+
+// out[i] (+)= in[i] * gain for n floats (n % 64 == 0), 128-byte blocks like the original.
+inline void GainBlocks(uint8_t* out, const uint8_t* in, uint32_t n, float gain, bool accumulate) {
+  for (uint32_t i = 0; i < n; i += 4) {
+    const simde_float32x4_t x = simde_vreinterpretq_f32_u8(simde_vrev32q_u8(simde_vld1q_u8(in + 4 * size_t(i))));
+    simde_float32x4_t r = simde_vmulq_n_f32(x, gain);
+    if (accumulate) {
+      const simde_float32x4_t o = simde_vreinterpretq_f32_u8(simde_vrev32q_u8(simde_vld1q_u8(out + 4 * size_t(i))));
+      r = simde_vaddq_f32(o, r);
+    }
+    simde_vst1q_u8(out + 4 * size_t(i), simde_vrev32q_u8(simde_vreinterpretq_u8_f32(r)));
+  }
+}
+
+// Needs `base` in scope. r3 = out, r4 = in, r6 = float count, f1 = gain. True = done.
+inline bool TryGain(PPCContext& ctx, uint8_t* base, bool accumulate) {
+  const uint32_t out = ctx.r3.u32, in = ctx.r4.u32, n = ctx.r6.u32;
+  if (((out | in) & 127) || (n & 63) || n == 0 || n > (1u << 20)) return false;
+  const uint64_t bytes = 4ull * n;
+  const bool same = out == in;
+  if (!same && !(uint64_t(out) + bytes <= in || uint64_t(in) + bytes <= out)) return false;
+  if (((uint64_t(out) + bytes - 1) >> 29) != (out >> 29) || ((uint64_t(in) + bytes - 1) >> 29) != (in >> 29)) return false;
+  uint8_t* out_ptr = static_cast<uint8_t*>(REX_RAW_ADDR(out));
+  const uint8_t* in_ptr = static_cast<const uint8_t*>(REX_RAW_ADDR(in));
+  if (!AllNormalOrZero(in_ptr, n) || (accumulate && !same && !AllNormalOrZero(out_ptr, n))) return false;
+  ctx.fpscr.disableFlushMode();  // the original converts the gain with flush mode off, then runs the vector loop with it on
+  const float gain = float(ctx.f1.f64);
+  if (!GainNormal(gain)) return false;  // nothing written; the fallback repeats the mode transitions itself
+  ctx.fpscr.enableFlushMode();
+  GainBlocks(out_ptr, in_ptr, n, gain, accumulate);
+  return true;
+}
+
+}  // namespace carbon::audio
diff --git a/src/audio_mixer_diag.cpp b/src/audio_mixer_diag.cpp
new file mode 100644
index 0000000..b136948
--- /dev/null
+++ b/src/audio_mixer_diag.cpp
@@ -0,0 +1,158 @@
+// Switch: timing of the game mixer's loop (diagnostic, log only).
+//
+// sub_826C6AB0 is the mixer thread's loop: wait for a free packet slot (sub_82A4DB58, the only wait),
+// mix one 6144-byte packet (sub_826C69E0) and submit it. The slot is freed by the voice's end-of-packet
+// callback (sub_826C6DA8, on the Audio Worker). The capture of 22:0x shows the mixer behind real time
+// (1,260-1,480 of 1,880 packets per 10 s) while idle in that wait 32-38% of the time: this measures how
+// long each wait lasts, how long a packet takes to mix, and how often/late the callback arrives, so the
+// next change targets the hand-off or the mix cost instead of guessing.
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+
+#include <atomic>
+
+#if defined(__SWITCH__)
+void CarbonLogLimitsLine();  // switch_limits_log.cpp
+#endif
+#include <chrono>
+
+#include "../generated/default/nfscarbon_pch.h"
+
+REXCVAR_DEFINE_BOOL(carbon_audio_mixer_diag, true, "CarbonAudio",
+                    "Log the game mixer's wait/mix/callback timing every 10 s ([mixer-diag])");
+
+extern "C" void __imp__sub_82A4DB58(PPCContext& __restrict ctx, uint8_t* base);
+extern "C" void __imp__sub_826C69E0(PPCContext& __restrict ctx, uint8_t* base);
+extern "C" void __imp__sub_826C6DA8(PPCContext& __restrict ctx, uint8_t* base);
+// Stages inside one mixer iteration (sub_826C6AB0): control/voice update, the 256-sample DSP chain and its
+// children, and the packet mix.
+extern "C" void __imp__sub_826AA418(PPCContext& __restrict ctx, uint8_t* base);
+extern "C" void __imp__sub_826B37C8(PPCContext& __restrict ctx, uint8_t* base);
+extern "C" void __imp__sub_826AEDE8(PPCContext& __restrict ctx, uint8_t* base);
+extern "C" void __imp__sub_826AC2A8(PPCContext& __restrict ctx, uint8_t* base);
+extern "C" void __imp__sub_826A3A50(PPCContext& __restrict ctx, uint8_t* base);
+extern "C" void __imp__sub_826B09E0(PPCContext& __restrict ctx, uint8_t* base);
+extern "C" void __imp__sub_826CE418(PPCContext& __restrict ctx, uint8_t* base);
+extern "C" void __imp__sub_826CE068(PPCContext& __restrict ctx, uint8_t* base);
+extern "C" void __imp__sub_826CDBA0(PPCContext& __restrict ctx, uint8_t* base);
+
+namespace {
+using Clock = std::chrono::steady_clock;
+
+int64_t NowUs() {
+  return std::chrono::duration_cast<std::chrono::microseconds>(Clock::now().time_since_epoch()).count();
+}
+
+struct Stat {
+  std::atomic<uint64_t> n{0}, total{0}, max{0}, over1ms{0}, over3ms{0}, under100us{0};
+  void Add(int64_t us) {
+    n.fetch_add(1, std::memory_order_relaxed);
+    total.fetch_add(uint64_t(us), std::memory_order_relaxed);
+    if (uint64_t(us) > max.load(std::memory_order_relaxed)) max.store(uint64_t(us), std::memory_order_relaxed);
+    if (us > 1000) over1ms.fetch_add(1, std::memory_order_relaxed);
+    if (us > 3000) over3ms.fetch_add(1, std::memory_order_relaxed);
+    if (us < 100) under100us.fetch_add(1, std::memory_order_relaxed);
+  }
+  void Take(uint64_t out[6]) {
+    out[0] = n.exchange(0);
+    out[1] = total.exchange(0);
+    out[2] = max.exchange(0);
+    out[3] = over1ms.exchange(0);
+    out[4] = over3ms.exchange(0);
+    out[5] = under100us.exchange(0);
+  }
+};
+
+Stat g_wait, g_mix, g_callback_gap;
+constexpr const char* kStageNames[] = {"AA418 voice/control", "B37C8 dsp chain", "AEDE8 filters", "AC2A8 post", "A3A50 gen",
+                                      "B09E0 pre", "CE418 mix voices", "CE068 mix sub", "CDBA0 mix pre"};
+Stat g_stage[9];
+std::atomic<int64_t> g_last_callback{0}, g_report_at{0};
+
+void MaybeReport(int64_t now) {
+  int64_t due = g_report_at.load(std::memory_order_relaxed);
+  if (due == 0) {
+    g_report_at.store(now + 10'000'000, std::memory_order_relaxed);
+    return;
+  }
+  if (now < due || !g_report_at.compare_exchange_strong(due, now + 10'000'000)) return;
+  uint64_t w[6], m[6], c[6];
+  g_wait.Take(w);
+  g_mix.Take(m);
+  g_callback_gap.Take(c);
+  for (size_t i = 0; i < 9; ++i) {
+    uint64_t st[6];
+    g_stage[i].Take(st);
+    if (st[0]) {
+      REXLOG_INFO("[mixer-diag]   stage {}: calls {} total {:.0f} ms (avg {:.2f} ms, max {:.1f}, >3 ms {})", kStageNames[i],
+                  st[0], double(st[1]) / 1000.0, double(st[1]) / double(st[0]) / 1000.0, double(st[2]) / 1000.0, st[4]);
+    }
+  }
+  const auto avg = [](const uint64_t* s) { return s[0] ? double(s[1]) / double(s[0]) / 1000.0 : 0.0; };
+#if defined(__SWITCH__)
+  CarbonLogLimitsLine();
+#endif
+  REXLOG_INFO("[mixer-diag] 10 s: waits {} avg {:.2f} ms max {:.1f} (<0.1 ms {}, >1 ms {}, >3 ms {}) | mixes {} avg {:.2f} ms "
+              "max {:.1f} (>6 ms {}) | callbacks {} gap avg {:.2f} ms max {:.1f} (>8 ms {})",
+              w[0], avg(w), double(w[2]) / 1000.0, w[5], w[3], w[4], m[0], avg(m), double(m[2]) / 1000.0, m[4], c[0], avg(c),
+              double(c[2]) / 1000.0, c[3]);
+}
+}  // namespace
+
+// The mixer's only wait: for the voice callback to free the packet slot.
+extern "C" REX_FUNC(sub_82A4DB58) {
+  if (!REXCVAR_GET(carbon_audio_mixer_diag)) {
+    __imp__sub_82A4DB58(ctx, base);
+    return;
+  }
+  const int64_t start = NowUs();
+  __imp__sub_82A4DB58(ctx, base);
+  const int64_t end = NowUs();
+  g_wait.Add(end - start);
+  MaybeReport(end);
+}
+
+// One packet of mixing.
+extern "C" REX_FUNC(sub_826C69E0) {
+  if (!REXCVAR_GET(carbon_audio_mixer_diag)) {
+    __imp__sub_826C69E0(ctx, base);
+    return;
+  }
+  const int64_t start = NowUs();
+  __imp__sub_826C69E0(ctx, base);
+  g_mix.Add(NowUs() - start);
+}
+
+// End-of-packet callback of the mixer's voice (Audio Worker).
+extern "C" REX_FUNC(sub_826C6DA8) {
+  if (REXCVAR_GET(carbon_audio_mixer_diag)) {
+    const int64_t now = NowUs();
+    const int64_t last = g_last_callback.exchange(now, std::memory_order_relaxed);
+    if (last) g_callback_gap.Add(now - last);
+  }
+  __imp__sub_826C6DA8(ctx, base);
+}
+
+namespace {
+template <void (*Original)(PPCContext&, uint8_t*)>
+void Timed(size_t slot, PPCContext& ctx, uint8_t* base) {
+  if (!REXCVAR_GET(carbon_audio_mixer_diag)) {
+    Original(ctx, base);
+    return;
+  }
+  const int64_t start = NowUs();
+  Original(ctx, base);
+  g_stage[slot].Add(NowUs() - start);
+}
+}  // namespace
+
+extern "C" REX_FUNC(sub_826AA418) { Timed<__imp__sub_826AA418>(0, ctx, base); }
+extern "C" REX_FUNC(sub_826B37C8) { Timed<__imp__sub_826B37C8>(1, ctx, base); }
+extern "C" REX_FUNC(sub_826AEDE8) { Timed<__imp__sub_826AEDE8>(2, ctx, base); }
+extern "C" REX_FUNC(sub_826AC2A8) { Timed<__imp__sub_826AC2A8>(3, ctx, base); }
+extern "C" REX_FUNC(sub_826A3A50) { Timed<__imp__sub_826A3A50>(4, ctx, base); }
+extern "C" REX_FUNC(sub_826B09E0) { Timed<__imp__sub_826B09E0>(5, ctx, base); }
+extern "C" REX_FUNC(sub_826CE418) { Timed<__imp__sub_826CE418>(6, ctx, base); }
+extern "C" REX_FUNC(sub_826CE068) { Timed<__imp__sub_826CE068>(7, ctx, base); }
