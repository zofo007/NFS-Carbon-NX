+// Carbon native renderer: texture content fingerprints on a background thread.
+//
+// Re-checking unchanged textures was 0.9-1.4 ms per race frame on the command
+// processor thread (31e259396430: 2.2 MiB/frame hashed, no changes). The MW port
+// hashes on another thread too. The CP thread submits a copy of what to hash
+// under an id and takes the finished (id, hash) pairs at the next frame start; it
+// alone decides what an id still means, so a result for a texture freed in the
+// meantime is simply dropped.
+#pragma once
+
+#include <condition_variable>
+#include <cstdint>
+#include <functional>
+#include <mutex>
+#include <thread>
+#include <utility>
+#include <vector>
+
+namespace carbon::gpu {
+
+template <typename Job>
+class BackgroundHasher {
+ public:
+  using Hash = std::function<uint64_t(const Job&)>;
+  using Result = std::pair<uint64_t, uint64_t>;  // (id, hash)
+
+  ~BackgroundHasher() { Stop(); }
+
+  void Start(Hash hash, std::function<void()> on_start = {}) {
+    if (worker_.joinable()) return;
+    hash_ = std::move(hash);
+    stop_ = false;
+    worker_ = std::thread([this, on_start = std::move(on_start)]() {
+      if (on_start) on_start();
+      Run();
+    });
+  }
+
+  // Unfinished jobs are dropped; Running() is false afterwards.
+  void Stop() {
+    if (!worker_.joinable()) return;
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      stop_ = true;
+    }
+    wake_.notify_one();
+    worker_.join();
+    jobs_.clear();
+    results_.clear();
+  }
+
+  bool Running() const { return worker_.joinable(); }
+
+  void Submit(uint64_t id, const Job& job) {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      jobs_.emplace_back(id, job);
+    }
+    wake_.notify_one();
+  }
+
+  // Appends the results finished so far.
+  void Take(std::vector<Result>& out) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    out.insert(out.end(), results_.begin(), results_.end());
+    results_.clear();
+  }
+
+ private:
+  void Run() {
+    std::vector<std::pair<uint64_t, Job>> batch;
+    std::vector<Result> done;
+    std::unique_lock<std::mutex> lock(mutex_);
+    for (;;) {
+      wake_.wait(lock, [&] { return stop_ || !jobs_.empty(); });
+      if (stop_) return;
+      batch.swap(jobs_);
+      lock.unlock();
+      for (const auto& [id, job] : batch) done.emplace_back(id, hash_(job));
+      batch.clear();
+      lock.lock();
+      results_.insert(results_.end(), done.begin(), done.end());
+      done.clear();
+    }
+  }
+
+  Hash hash_;
+  std::thread worker_;
+  std::mutex mutex_;
+  std::condition_variable wake_;
+  bool stop_ = false;
+  std::vector<std::pair<uint64_t, Job>> jobs_;
+  std::vector<Result> results_;
+};
+
+}  // namespace carbon::gpu
