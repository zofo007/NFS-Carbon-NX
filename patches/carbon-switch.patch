diff --git a/renderer/src/index_cache.h b/renderer/src/index_cache.h
new file mode 100644
index 0000000..e1fa133
--- /dev/null
+++ b/renderer/src/index_cache.h
@@ -0,0 +1,42 @@
+// Carbon native renderer: converted guest index ranges kept in the vertex arena.
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <type_traits>
+
+namespace carbon::gpu {
+
+// Everything the conversion depends on. Hashed for the map and compared in full, so it
+// must have no padding (a pipeline key with gap bytes once duplicated pipelines in the MW port).
+struct IndexCacheKey {
+  uint32_t address = 0;      // guest physical address of the first index
+  uint32_t bytes = 0;        // count * index size
+  uint32_t reset_index = 0;  // primitive restart value (only meaningful when restart)
+  uint8_t is16 = 0, endian = 0, restart = 0, unused = 0;
+  bool operator==(const IndexCacheKey&) const = default;
+};
+static_assert(std::has_unique_object_representations_v<IndexCacheKey>);
+
+struct IndexCacheEntry {
+  IndexCacheKey key;
+  uint32_t offset = 0;      // bytes in the arena (host indices)
+  uint32_t lo = 1, hi = 0;  // index range found by the conversion (lo > hi: none)
+  uint64_t hash = 0;        // of the guest bytes, never 0
+  uint64_t checked = 0;     // frame of the last hash check
+  uint8_t interval = 1;     // frames between checks, doubling while unchanged
+};
+
+// The vertex arena's rule: an unchanged range is checked less and less often, at most
+// every max_interval frames, and never twice in one frame. Returns false when the guest
+// bytes changed (the caller copies them into fresh arena space).
+template <typename HashGuest>
+bool IndexCacheFresh(IndexCacheEntry& e, uint64_t frame, uint8_t max_interval, HashGuest&& hash_guest) {
+  if (e.checked == frame || frame < e.checked + e.interval) return true;
+  if (hash_guest() != e.hash) return false;
+  e.checked = frame;
+  e.interval = uint8_t(std::min<uint32_t>(uint32_t(e.interval) * 2, max_interval));
+  return true;
+}
+
+}  // namespace carbon::gpu
diff --git a/renderer/src/index_upload_cache.h b/renderer/src/index_upload_cache.h
new file mode 100644
index 0000000..682ee7d
--- /dev/null
+++ b/renderer/src/index_upload_cache.h
@@ -0,0 +1,127 @@
+#pragma once
+
+#include <simde/x86/sse4.1.h>
+#include <vulkan/vulkan_core.h>
+#include "gpu_common.h"
+
+namespace carbon::gpu {
+
+// Command-thread only. Uploaded index bytes remain immutable in their frame slot.
+class IndexUploadCache {
+ public:
+  struct Key {
+    uint32_t address, count, reset;
+    xenos::Endian endian;
+    bool is16, restart;
+    bool operator==(const Key&) const = default;
+  };
+  struct Entry {
+    Key key{};
+    const uint8_t* converted = nullptr;
+    VkBuffer buffer = VK_NULL_HANDLE;
+    VkDeviceSize offset = 0;
+    uint32_t lo = 0, hi = 0;
+    uint64_t frame = 0;
+  };
+
+  const Entry* Find(const Key& key, const uint8_t* guest, uint64_t frame) {
+    Entry& e = entries_[Slot(key)];
+    if (!e.converted || e.frame != frame || !(e.key == key)) return nullptr;
+    if (key.is16) {
+      // A custom reset aliases a genuine 0xFFFF index after conversion; do not reuse its range.
+      if (key.restart && key.reset != 0xFFFF) return nullptr;
+      const bool swap = key.endian == xenos::Endian::k8in16 || key.endian == xenos::Endian::k8in32;
+      const bool equal = swap ? Matches<uint16_t, xenos::Endian::k8in16, false>(guest, e.converted, key.count, 0)
+                              : !std::memcmp(guest, e.converted, size_t(key.count) * 2);
+      if (equal) return &e;
+    } else {
+      bool equal;
+      switch (key.endian) {
+        case xenos::Endian::k8in16: equal = Matches32<xenos::Endian::k8in16>(key, guest, e.converted); break;
+        case xenos::Endian::k8in32: equal = Matches32<xenos::Endian::k8in32>(key, guest, e.converted); break;
+        case xenos::Endian::k16in32: equal = Matches32<xenos::Endian::k16in32>(key, guest, e.converted); break;
+        default: equal = Matches32<xenos::Endian::kNone>(key, guest, e.converted); break;
+      }
+      if (equal) return &e;
+    }
+    // A rewrite keeps the original path for this key until the next frame.
+    e.converted = nullptr;
+    return nullptr;
+  }
+
+  void Store(const Key& key, const uint8_t* converted, VkBuffer buffer, VkDeviceSize offset,
+             uint32_t lo, uint32_t hi, uint64_t frame) {
+    if (key.is16 && key.restart && key.reset != 0xFFFF) return;
+    Entry& e = entries_[Slot(key)];
+    if (!e.converted && e.frame == frame && e.key == key) return;
+    e = {key, converted, buffer, offset, lo, hi, frame};
+  }
+
+ private:
+  template <typename T, xenos::Endian kEndian, bool kRestart>
+  static bool Matches(const uint8_t* guest, const uint8_t* converted, uint32_t count, uint32_t reset) {
+    const auto* out = reinterpret_cast<const T*>(converted);
+    const auto read = [&](uint32_t i) {
+      T v;
+      std::memcpy(&v, guest + size_t(i) * sizeof(T), sizeof(T));
+      if constexpr (sizeof(T) == 2) {
+        v = ByteSwap16(v);
+      } else {
+        v = GpuSwap32(v, kEndian) & 0xFFFFFF;
+        if constexpr (kRestart) { if (v == reset) v = UINT32_MAX; }
+      }
+      return v;
+    };
+    uint32_t first = 0;
+    const auto decode = [&](simde__m128i v) {
+      if constexpr (sizeof(T) == 2 || kEndian == xenos::Endian::k8in16) {
+        v = simde_mm_shuffle_epi8(v, simde_mm_setr_epi8(1, 0, 3, 2, 5, 4, 7, 6, 9, 8, 11, 10, 13, 12, 15, 14));
+      } else if constexpr (kEndian == xenos::Endian::k8in32) {
+        v = simde_mm_shuffle_epi8(v, simde_mm_setr_epi8(3, 2, 1, 0, 7, 6, 5, 4, 11, 10, 9, 8, 15, 14, 13, 12));
+      } else if constexpr (kEndian == xenos::Endian::k16in32) {
+        v = simde_mm_shuffle_epi8(v, simde_mm_setr_epi8(2, 3, 0, 1, 6, 7, 4, 5, 10, 11, 8, 9, 14, 15, 12, 13));
+      }
+      if constexpr (sizeof(T) == 4) {
+        v = simde_mm_and_si128(v, simde_mm_set1_epi32(0xFFFFFF));
+        if constexpr (kRestart) v = simde_mm_or_si128(v, simde_mm_cmpeq_epi32(v, simde_mm_set1_epi32(int32_t(reset))));
+      }
+      return v;
+    };
+    constexpr uint32_t kLanes = 16 / sizeof(T);
+    const uint32_t block_end = count & ~(4 * kLanes - 1);
+    const uint32_t vector_end = count & ~(kLanes - 1);
+    // Check 64 bytes at a time: full validation on hits, bounded work before a miss.
+    for (; first < block_end; first += 4 * kLanes) {
+      simde__m128i diff = simde_mm_setzero_si128();
+      for (uint32_t j = 0; j < 4; ++j) {
+        const size_t offset = size_t(first) * sizeof(T) + j * 16;
+        const auto v = decode(simde_mm_loadu_si128(guest + offset));
+        diff = simde_mm_or_si128(diff, simde_mm_xor_si128(v, simde_mm_loadu_si128(converted + offset)));
+      }
+      if (!simde_mm_testz_si128(diff, diff)) return false;
+    }
+    for (; first < vector_end; first += kLanes) {
+      const size_t offset = size_t(first) * sizeof(T);
+      const auto diff = simde_mm_xor_si128(decode(simde_mm_loadu_si128(guest + offset)),
+                                           simde_mm_loadu_si128(converted + offset));
+      if (!simde_mm_testz_si128(diff, diff)) return false;
+    }
+    for (; first < count; ++first) { if (read(first) != out[first]) return false; }
+    return true;
+  }
+  template <xenos::Endian kEndian>
+  static bool Matches32(const Key& key, const uint8_t* guest, const uint8_t* converted) {
+    return key.restart ? Matches<uint32_t, kEndian, true>(guest, converted, key.count, key.reset)
+                       : Matches<uint32_t, kEndian, false>(guest, converted, key.count, key.reset);
+  }
+  static uint32_t Slot(const Key& key) {
+    uint32_t h = (key.address >> 1) ^ key.count * 0x9E3779B9u ^ key.reset ^
+                 (uint32_t(key.endian) << 20) ^ (uint32_t(key.is16) << 24) ^
+                 (uint32_t(key.restart) << 25);
+    h = (h ^ (h >> 16)) * 0x85EBCA6Bu;
+    return (h ^ (h >> 13)) & 4095;
+  }
+  std::array<Entry, 4096> entries_{};
+};
+
+}  // namespace carbon::gpu
