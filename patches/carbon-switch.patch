+// `n` bytes from guest address `addr`, each read as ReadByteSwapped does. Inside an aligned 4-byte group the
+// xor only permutes the group (xor_mask < 4), so whole groups are one load plus a byte permutation.
+// Little-endian host (Switch ARM64, x86); the 512 MB address mask never splits a group.
+inline void CopySwapped(uint8_t* dst, const uint8_t* mem, uint32_t addr, uint32_t n, uint32_t xor_mask) {
+  uint32_t i = 0;
+  if ((addr & 0x1FFFFFFFu) + n <= 0x20000000u) {
+    for (; i < n && ((addr + i) & 3); ++i) dst[i] = ReadByteSwapped(mem, addr + i, xor_mask);
+    const uint8_t* src = mem + ((addr + i) & 0x1FFFFFFFu);
+    for (; i + 4 <= n; i += 4, src += 4) {
+      uint32_t w;
+      std::memcpy(&w, src, 4);
+      switch (xor_mask) {
+        case 1: w = ((w & 0x00FF00FFu) << 8) | ((w >> 8) & 0x00FF00FFu); break;
+        case 2: w = (w << 16) | (w >> 16); break;
+        case 3: w = __builtin_bswap32(w); break;
+        default: break;
+      }
+      std::memcpy(dst + i, &w, 4);
+    }
+  }
+  for (; i < n; ++i) dst[i] = ReadByteSwapped(mem, addr + i, xor_mask);
+}
