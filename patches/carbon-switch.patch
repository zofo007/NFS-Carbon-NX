+                        []() { rex::thread::set_current_thread_name("Texture Hash"); });
+}
+
+// At frame start, with the upload command buffer open. Ids of textures evicted
+// meanwhile are gone from hash_jobs_, so their results are dropped.
+void Renderer::ApplyTextureHashes() {
+  texture_hasher_.Take(hash_results_);
+  for (const auto& [id, hash] : hash_results_) {
+    auto it = hash_jobs_.find(id);
+    if (it == hash_jobs_.end()) continue;
+    Texture* t = it->second;
+    hash_jobs_.erase(it);
+    t->hash_job = 0;
+    ApplyTextureHash(*t, hash);
+  }
+  hash_results_.clear();
+}
