diff --git a/src/audio_server_wait.h b/src/audio_server_wait.h
new file mode 100644
index 0000000..b373dae
--- /dev/null
+++ b/src/audio_server_wait.h
@@ -0,0 +1,98 @@
+#pragma once
+
+// Wait for Carbon's audio mixer packet before each audio frame (MW's nfsmw_audio_esperar_servidor_ms,
+// reference-nfsmw-nx/app/src/nfsmw_audio_servidor.cpp, with Carbon's own layout).
+//
+// The game's mixer thread "RWAudioCore Dac" (sub_826C6AB0, object in r3) mixes into a ring of two
+// 6144-byte packets at obj+68 and submits them to one XAudio source voice (obj+64) with
+// sub_82A4C630. Packet states at obj+12544+4*i: 0 free, 1 full, 2 submitted. The voice's
+// end-of-packet callback (sub_826C6DA8, on the Audio Worker) frees the slot and signals the mixer.
+// If the mixer has not submitted the next packet when XAudio renders a frame, the voice plays
+// silence: the dropouts with many overlapping sounds (frames reach the SDK on time, but silent).
+// Waiting here lets the SDK queue (audio_switch_tramas_en_cola) absorb the late mix instead.
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <cstring>
+#include <mutex>
+
+namespace carbon::audio_server {
+
+constexpr uint32_t kVoice = 64;
+constexpr uint32_t kStates = 12544;
+constexpr uint32_t kSubmitted = 2;
+constexpr uint32_t kRunning = 0x82C236EF;  // the mixer loop runs while nonzero
+constexpr uint32_t kMixing = 0x82C236EE;   // zero: the loop only services commands (paused)
+// No submission for this long: loading, videos or pause. Never wait then.
+constexpr int64_t kStoppedUs = 300'000;
+
+// Switch only (the hook builds only there): guest physical addresses have no host offset.
+inline uint32_t Load32(const uint8_t* base, uint32_t address) {
+  uint32_t value = 0;
+  std::memcpy(&value, base + address, sizeof(value));
+  return __builtin_bswap32(value);
+}
+
+struct Waiter {
+  std::mutex mutex;
+  std::condition_variable cv;
+  std::atomic<int> submitting{0};
+  std::atomic<int64_t> last_submit_us{0};
+  std::atomic<uint64_t> waits{0}, timeouts{0}, waited_us{0}, max_us{0}, submits{0};
+
+  // A packet the voice can render, and no submission halfway through (Carbon marks state 2 first).
+  bool Ready(const uint8_t* base, uint32_t obj) const {
+    return (Load32(base, obj + kStates) == kSubmitted || Load32(base, obj + kStates + 4) == kSubmitted) &&
+           submitting.load(std::memory_order_acquire) == 0;
+  }
+
+  // Audio Worker, before each frame. Returns the microseconds waited, or -1 when it did not wait.
+  template <typename NowUs>
+  int64_t Wait(const uint8_t* base, uint32_t obj, int32_t max_ms, NowUs now_us) {
+    if (max_ms <= 0 || Ready(base, obj)) return -1;
+    const int64_t start = now_us();
+    if (base[kRunning] == 0 || base[kMixing] == 0 ||
+        start - last_submit_us.load(std::memory_order_relaxed) > kStoppedUs) {
+      return -1;
+    }
+    const int64_t limit = start + int64_t(max_ms) * 1000;
+    bool timed_out = false;
+    {
+      std::unique_lock<std::mutex> lock(mutex);
+      while (!Ready(base, obj)) {
+        const int64_t now = now_us();
+        if (now >= limit) {
+          timed_out = true;
+          break;
+        }
+        // 1 ms slices: a notification that lands between the check and the wait costs at most that.
+        cv.wait_for(lock, std::chrono::microseconds(std::min<int64_t>(1000, limit - now)));
+      }
+    }
+    const int64_t waited = now_us() - start;
+    waits.fetch_add(1, std::memory_order_relaxed);
+    timeouts.fetch_add(timed_out ? 1 : 0, std::memory_order_relaxed);
+    waited_us.fetch_add(uint64_t(waited), std::memory_order_relaxed);
+    if (uint64_t(waited) > max_us.load(std::memory_order_relaxed)) {
+      max_us.store(uint64_t(waited), std::memory_order_relaxed);
+    }
+    return waited;
+  }
+
+  // Mixer thread, around its SubmitPacket.
+  void BeginSubmit() { submitting.fetch_add(1, std::memory_order_acq_rel); }
+  void EndSubmit(int64_t now_us) {
+    last_submit_us.store(now_us, std::memory_order_relaxed);
+    submits.fetch_add(1, std::memory_order_relaxed);
+    {
+      std::lock_guard<std::mutex> lock(mutex);
+      submitting.fetch_sub(1, std::memory_order_acq_rel);
+    }
+    cv.notify_all();
+  }
+};
+
+}  // namespace carbon::audio_server
diff --git a/src/audio_server_wait_hook.cpp b/src/audio_server_wait_hook.cpp
new file mode 100644
index 0000000..8c50d51
--- /dev/null
+++ b/src/audio_server_wait_hook.cpp
@@ -0,0 +1,98 @@
+// Switch: before each audio frame, wait (bounded) for the game mixer's packet instead of letting
+// XAudio render its voice silent. See audio_server_wait.h for the mixer's layout and the failure.
+//
+// carbon_audio_wait_server_ms (default 30, MW's default; 0 = off): the longest the Audio Worker waits
+// per frame. The SDK hook (rex::audio::SetGanchoAntesDeTrama) is registered by the mixer thread itself
+// on entering its loop, and SubmitPacket on the mixer's voice notifies the wait. A [audio-server]
+// line every 10 s gives waits, timeouts and wait times. The SDK's worker-block counters now include
+// these waits.
+
+#include <rex/audio/audio_system.h>
+#include <rex/cvar.h>
+#include <rex/logging.h>
+
+#include "../generated/default/nfscarbon_pch.h"
+#include "audio_server_wait.h"
+
+REXCVAR_DEFINE_INT32(carbon_audio_wait_server_ms, 30, "CarbonAudio",
+                     "Before each audio frame, wait at most N ms for the game mixer (RWAudioCore Dac) to submit "
+                     "its packet instead of rendering its voice silent; 0 = off. Needs audio_switch_tramas_en_cola "
+                     "of cushion")
+    .range(0, 100);
+// MW pairs the wait with its server at 0x2D. With the wait alone (e6670266cf1a) the mixer still fell to
+// 60-85% of real time near AI cars/particles, at 0x3B below the 0x3A handoff threads. Alone, 0x2D was
+// rejected twice (852a1a901a15, 97b8ff5f4ca2), when late mixes still went out silent.
+REXCVAR_DEFINE_INT32(carbon_audio_mixer_priority, 0x2D, "CarbonAudio",
+                     "Horizon priority of the game's audio mixer thread (RWAudioCore Dac), 0x1C-0x3A; "
+                     "0 = leave it with the game threads at 0x3B")
+    .range(0, 0x3B);
+
+extern "C" bool RexSwitchSetCurrentThreadPriorityOk(int priority);
+extern "C" void __imp__sub_826C6AB0(PPCContext& __restrict ctx, uint8_t* base);
+extern "C" void __imp__sub_82A4C630(PPCContext& __restrict ctx, uint8_t* base);
+
+namespace {
+using carbon::audio_server::Waiter;
+
+Waiter g_waiter;
+std::atomic<uint32_t> g_obj{0};
+std::atomic<uint8_t*> g_base{nullptr};
+int64_t g_report_at = 0;  // Audio Worker only
+
+int64_t NowUs() {
+  return std::chrono::duration_cast<std::chrono::microseconds>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+void MaybeReport(int64_t now) {
+  if (g_report_at == 0) g_report_at = now + 10'000'000;
+  if (now < g_report_at) return;
+  g_report_at = now + 10'000'000;
+  Waiter& w = g_waiter;
+  const uint64_t waits = w.waits.exchange(0, std::memory_order_relaxed);
+  const uint64_t waited = w.waited_us.exchange(0, std::memory_order_relaxed);
+  REXLOG_INFO("[audio-server] 10 s: waits {} (timed out {}), waited {:.1f} ms total, avg {} us, max {} us | "
+              "mixer submits {} | limit {} ms",
+              waits, w.timeouts.exchange(0, std::memory_order_relaxed), waited * 1e-3, waits ? waited / waits : 0,
+              w.max_us.exchange(0, std::memory_order_relaxed), w.submits.exchange(0, std::memory_order_relaxed),
+              REXCVAR_GET(carbon_audio_wait_server_ms));
+}
+
+void BeforeFrame(size_t) {
+  const uint32_t obj = g_obj.load(std::memory_order_acquire);
+  const uint8_t* base = g_base.load(std::memory_order_relaxed);
+  if (obj == 0 || base == nullptr) return;
+  g_waiter.Wait(base, obj, REXCVAR_GET(carbon_audio_wait_server_ms), NowUs);
+  MaybeReport(NowUs());
+}
+}  // namespace
+
+// The mixer thread's loop, entered once per audio session.
+extern "C" REX_FUNC(sub_826C6AB0) {
+  g_base.store(base, std::memory_order_relaxed);
+  g_obj.store(ctx.r3.u32, std::memory_order_release);
+  rex::audio::SetGanchoAntesDeTrama(&BeforeFrame);
+  REXLOG_INFO("[audio-server] mixer 0x{:08X}: wait for its packet before each frame, at most {} ms (0 = off)",
+              ctx.r3.u32, REXCVAR_GET(carbon_audio_wait_server_ms));
+  const int32_t priority = REXCVAR_GET(carbon_audio_mixer_priority);
+  if (priority >= 0x1C && priority <= 0x3A) {
+    const bool ok = RexSwitchSetCurrentThreadPriorityOk(priority);
+    REXLOG_INFO("[audio-server] mixer thread priority 0x{:X}: {}", priority, ok ? "done" : "failed");
+  }
+  __imp__sub_826C6AB0(ctx, base);
+  rex::audio::SetGanchoAntesDeTrama(nullptr);
+  g_obj.store(0, std::memory_order_release);
+}
+
+// XAudio source voice SubmitPacket(voice, packet, flags).
+extern "C" REX_FUNC(sub_82A4C630) {
+  const uint32_t obj = g_obj.load(std::memory_order_acquire);
+  if (obj == 0 || ctx.r3.u32 != carbon::audio_server::Load32(base, obj + carbon::audio_server::kVoice)) {
+    __imp__sub_82A4C630(ctx, base);
+    return;
+  }
+  g_waiter.BeginSubmit();
+  __imp__sub_82A4C630(ctx, base);
+  g_waiter.EndSubmit(NowUs());
+}
diff --git a/src/audio_unpack_fast.h b/src/audio_unpack_fast.h
new file mode 100644
index 0000000..548040d
--- /dev/null
+++ b/src/audio_unpack_fast.h
@@ -0,0 +1,65 @@
+#pragma once
+// sub_826B56A8 (sample unpack), mode 1: big-endian int16 samples -> big-endian floats scaled by 2^-15.
+// The game reads n1 samples at r6 + (r7 & ~1) and n2 more from r6 (ring wrap) into one float run at r4.
+// Every int16 * 2^-15 is exact, so a NEON loop gives the same bits as the VMX/scalar code; anything the
+// fast path does not model (other modes, odd alignment, overlap, unexpected scale constant) returns false
+// and the caller runs the register-local copy of the original. Tested bit-exact in tests/native_leaf_test.cpp.
+#include <simde/arm/neon.h>
+
+#include <cstdint>
+#include <cstring>
+
+namespace carbon::audio {
+
+inline void UnpackS16BE(const uint8_t* src, uint8_t* dst, uint32_t n) {
+  const float scale = 1.0f / 32768.0f;
+  uint32_t i = 0;
+  for (; i + 8 <= n; i += 8) {
+    const simde_int16x8_t h = simde_vreinterpretq_s16_u8(simde_vrev16q_u8(simde_vld1q_u8(src + 2 * size_t(i))));
+    const simde_float32x4_t lo = simde_vmulq_n_f32(simde_vcvtq_f32_s32(simde_vmovl_s16(simde_vget_low_s16(h))), scale);
+    const simde_float32x4_t hi = simde_vmulq_n_f32(simde_vcvtq_f32_s32(simde_vmovl_s16(simde_vget_high_s16(h))), scale);
+    simde_vst1q_u8(dst + 4 * size_t(i), simde_vrev32q_u8(simde_vreinterpretq_u8_f32(lo)));
+    simde_vst1q_u8(dst + 4 * size_t(i) + 16, simde_vrev32q_u8(simde_vreinterpretq_u8_f32(hi)));
+  }
+  for (; i < n; ++i) {
+    const float f = float(int16_t(uint16_t(src[2 * size_t(i)] << 8 | src[2 * size_t(i) + 1]))) * scale;
+    uint32_t u;
+    std::memcpy(&u, &f, 4);
+    dst[4 * size_t(i) + 0] = uint8_t(u >> 24);
+    dst[4 * size_t(i) + 1] = uint8_t(u >> 16);
+    dst[4 * size_t(i) + 2] = uint8_t(u >> 8);
+    dst[4 * size_t(i) + 3] = uint8_t(u);
+  }
+}
+
+// Needs `base` in scope (REX_LOAD_U32 / REX_RAW_ADDR). True = done (the guest-visible effects of the original
+// are applied); false = nothing touched, run the original.
+inline bool TryUnpackB56A8(PPCContext& ctx, uint8_t* base) {
+  if (ctx.r8.u32 != 1) return false;
+  const int32_t n1 = ctx.r9.s32, n2 = ctx.r10.s32;
+  if (n1 < 0 || n2 < 0 || REX_LOAD_U32(0x820C7F24) != 0x38000000u) return false;  // f0 = 2^-15
+  const uint32_t dst = ctx.r4.u32, src2 = ctx.r6.u32, src1 = src2 + (ctx.r7.u32 & ~1u);
+  if (n2 >= 16 && (src2 & 15)) return false;  // the original's aligned vector loads would round down
+  const uint64_t dst_bytes = 4ull * (uint64_t(n1) + uint64_t(n2));
+  const auto one_region = [](uint32_t a, uint64_t len) { return len == 0 || ((uint64_t(a) + len - 1) >> 29) == (a >> 29); };
+  const auto disjoint = [](uint32_t a, uint64_t alen, uint32_t b, uint64_t blen) {
+    return alen == 0 || blen == 0 || uint64_t(a) + alen <= b || uint64_t(b) + blen <= a;
+  };
+  if (!one_region(dst, dst_bytes) || !one_region(src1, 2ull * n1) || !one_region(src2, 2ull * n2) ||
+      !disjoint(dst, dst_bytes, src1, 2ull * n1) || !disjoint(dst, dst_bytes, src2, 2ull * n2)) {
+    return false;
+  }
+  REX_STORE_U32(ctx.r1.u32 + 44, ctx.r6.u32);
+  // The original's FP mode transitions, in order (they decide the mode the caller continues in).
+  ctx.fpscr.disableFlushMode();
+  if ((dst & 0x7F) == 0 && n1 + n2 >= 32) ctx.fpscr.disableFlushMode();  // its dcbz loop; the lines are overwritten
+  if (n1 >= 16) ctx.fpscr.enableFlushMode();
+  if (n1 >= 16 ? (n1 & 15) != 0 : n1 != 0) ctx.fpscr.disableFlushMode();
+  if (n2 >= 16) ctx.fpscr.enableFlushMode();
+  if (n2 >= 16 ? (n2 & 15) != 0 : n2 != 0) ctx.fpscr.disableFlushMode();
+  if (n1) UnpackS16BE(static_cast<const uint8_t*>(REX_RAW_ADDR(src1)), static_cast<uint8_t*>(REX_RAW_ADDR(dst)), uint32_t(n1));
+  if (n2) UnpackS16BE(static_cast<const uint8_t*>(REX_RAW_ADDR(src2)), static_cast<uint8_t*>(REX_RAW_ADDR(dst)) + 4 * size_t(n1), uint32_t(n2));
+  return true;
+}
+
+}  // namespace carbon::audio
diff --git a/src/dlc_install.cpp b/src/dlc_install.cpp
new file mode 100644
index 0000000..eeb8e35
--- /dev/null
+++ b/src/dlc_install.cpp
@@ -0,0 +1,49 @@
+// Installs DLC packages (Xbox 360 STFS files) found in <executable folder>/dlc.
+//
+// The SDK enumerates marketplace content (type 00000002) from extracted folders under
+// <user data>/content/0000000000000000/<title id>/00000002/<name>/ (ContentManager::ListContent) and has
+// ContentManager::InstallContent to extract a package there, but nothing calls it. This does at startup, for
+// every file under dlc/ whose header says LIVE, PIRS or CON (any depth, any file name: the dumps keep the
+// 454107EC/00000002/<hash> layout). Extraction is a few KB per package and is repeated at each launch.
+#include <rex/filesystem.h>
+#include <rex/logging.h>
+#include <rex/runtime.h>
+#include <rex/system/kernel_state.h>
+#include <rex/system/xam/content_manager.h>
+
+#include <cstdio>
+#include <cstring>
+#include <filesystem>
+#include <system_error>
+
+
+void CarbonInstallDlc(rex::Runtime* runtime) {
+  std::error_code ec;
+  const std::filesystem::path root = rex::filesystem::GetExecutableFolder() / "dlc";
+  if (!runtime || !std::filesystem::is_directory(root, ec)) return;
+  auto* kernel_state = runtime->kernel_state();
+  auto* content = kernel_state ? kernel_state->content_manager() : nullptr;
+  if (!content) return;
+  int installed = 0, failed = 0;
+  for (std::filesystem::recursive_directory_iterator it(root, ec), end; !ec && it != end; it.increment(ec)) {
+    if (!it->is_regular_file(ec) || it->file_size(ec) < 0xA000) continue;
+    char magic[4] = {};
+    if (FILE* f = std::fopen(it->path().string().c_str(), "rb")) {
+      const size_t got = std::fread(magic, 1, 4, f);
+      std::fclose(f);
+      if (got != 4) continue;
+    } else {
+      continue;
+    }
+    if (std::memcmp(magic, "LIVE", 4) && std::memcmp(magic, "PIRS", 4) && std::memcmp(magic, "CON ", 4)) continue;
+    const auto result = content->InstallContent(it->path());
+    if (result == 0) {
+      ++installed;
+    } else {
+      ++failed;
+    }
+    REXLOG_INFO("[dlc] {} -> {:08X}", it->path().filename().string(), uint32_t(result));
+  }
+  REXLOG_INFO("[dlc] {}: {} package(s) installed, {} failed (title {:08X})", root.string(), installed, failed,
+              kernel_state->title_id());
+}
diff --git a/src/frame_handoff_hook.cpp b/src/frame_handoff_hook.cpp
new file mode 100644
index 0000000..f968bb0
--- /dev/null
+++ b/src/frame_handoff_hook.cpp
@@ -0,0 +1,120 @@
+// Switch: the game's frame handoff without a Sleep(0) spin (the MW port's approach,
+// reference-nfsmw-nx/app/src/nfsmw_espera_fotograma.cpp, with Carbon's own addresses).
+//
+// The game splits each frame between two threads with a flag at 0x82C651C4 (MW's engine has the
+// same handoff at 0x82A2CF40). The render thread (sub_824E9948, called from sub_8250ABE8) waits for
+// the flag to go back to 0 before preparing the next frame; the main thread (sub_824E9720) waits for
+// it to become 1 before running the commands. Both wait by calling the game's Sleep(0) (sub_82943548)
+// in a loop. In the SDK a zero delay on a normal-priority thread is MaybeYield() = sched_yield(),
+// which on Horizon yields only to threads of the same priority and otherwise returns at once: the two
+// loops spin on cores already ~250 % busy of 300 (f3114a8cdca0 race; the CP waits ~8 ms/frame on the
+// game).
+//
+// carbon_handoff_sleep (default on): those two calls (their return addresses, 0 ms) sleep 100 us
+// instead, MW's nfsmw_ejecutor_pausa_us; the game's loop re-checks the flag. Every 64th one still runs
+// the original, which also checks for title termination. Every other Sleep runs the original.
+// carbon_handoff_priority (default 0x3A, 0 = untouched): MW's nfsmw_relevo_prioridad for both handoff
+// threads, applied on each one's first handoff wait, so a woken thread does not wait out another guest
+// thread's 10 ms slice. Default since the 13:26 run (user: noticeable improvement; audio 0/103,484 missing
+// with Carbon's mixer at 0x3B).
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <rex/thread.h>
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+
+#include "../generated/default/nfscarbon_pch.h"
+
+REXCVAR_DEFINE_BOOL(carbon_handoff_sleep, true, "CarbonPerf",
+                    "Frame handoff loops (sub_824E9720 / sub_824E9948) sleep 100 us instead of spinning on Sleep(0)");
+REXCVAR_DEFINE_INT32(carbon_handoff_priority, 0x3A, "CarbonPerf",
+                     "Horizon priority for the two frame handoff threads (default 0x3A as in MW; 0 = untouched 0x3B)")
+    .range(0, 0x3B);
+
+extern "C" void __imp__sub_82943548(PPCContext& __restrict ctx, uint8_t* base);
+extern "C" bool RexSwitchSetCurrentThreadPriorityOk(int priority);
+extern "C" void RexSwitchPerfSetThreadName(uint32_t handle, const char* name);
+extern "C" uint32_t threadGetCurHandle(void);  // libnx
+
+namespace {
+constexpr uint32_t kMainWaitReturn = 0x824E977C;    // sub_824E9720: wait for the flag to become 1
+constexpr uint32_t kRenderWaitReturn = 0x824E99E4;  // sub_824E9948: wait for the flag to go back to 0
+constexpr const char* kSide[2] = {"main", "render"};
+
+struct Side {
+  std::atomic<uint64_t> waits{0}, slept_ns{0}, max_ns{0};
+};
+Side g_side[2];
+std::atomic<int64_t> g_report_at{0};
+
+int64_t NowNs() {
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+void RaisePriorityOnce(int side) {
+  thread_local bool done = false;
+  if (done) return;
+  done = true;
+  // Profiler label only (the game's thread name is an address): lets perfil_hotspots.flag sample it.
+  if (side == 1) RexSwitchPerfSetThreadName(threadGetCurHandle(), "Render XThread");
+  const int32_t priority = REXCVAR_GET(carbon_handoff_priority);
+  if (priority >= 0x1C && priority <= 0x3B) {
+    const bool ok = RexSwitchSetCurrentThreadPriorityOk(int(priority));
+    REXLOG_INFO("[handoff] {} thread priority {:#x} ({})", kSide[side], uint32_t(priority),
+                ok ? "accepted" : "REJECTED by the kernel");
+  } else {
+    REXLOG_INFO("[handoff] {} thread priority untouched (0x3B)", kSide[side]);
+  }
+}
+
+// One line every 10 s from the main thread's handoff.
+void MaybeReport(int64_t now) {
+  int64_t due = g_report_at.load(std::memory_order_relaxed);
+  if (due == 0) {
+    g_report_at.store(now + 10'000'000'000, std::memory_order_relaxed);
+    return;
+  }
+  if (now < due) return;
+  g_report_at.store(now + 10'000'000'000, std::memory_order_relaxed);
+  uint64_t w[2], s[2], m[2];
+  for (int i = 0; i < 2; ++i) {
+    w[i] = g_side[i].waits.exchange(0, std::memory_order_relaxed);
+    s[i] = g_side[i].slept_ns.exchange(0, std::memory_order_relaxed);
+    m[i] = g_side[i].max_ns.exchange(0, std::memory_order_relaxed);
+  }
+  REXLOG_INFO("[handoff] 10 s: main waits {} ({:.1f} ms asleep, max {:.0f} us), render waits {} ({:.1f} ms "
+              "asleep, max {:.0f} us) | sleep {}, priority {}",
+              w[0], s[0] * 1e-6, m[0] * 1e-3, w[1], s[1] * 1e-6, m[1] * 1e-3,
+              REXCVAR_GET(carbon_handoff_sleep) ? "on" : "off", REXCVAR_GET(carbon_handoff_priority));
+}
+}  // namespace
+
+extern "C" REX_FUNC(sub_82943548) {
+  const uint32_t ret = uint32_t(ctx.lr);
+  const int side = ret == kMainWaitReturn ? 0 : ret == kRenderWaitReturn ? 1 : -1;
+  if (side < 0 || ctx.r3.u32 != 0 || !REXCVAR_GET(carbon_handoff_sleep)) {
+    __imp__sub_82943548(ctx, base);
+    return;
+  }
+  RaisePriorityOnce(side);
+  Side& s = g_side[side];
+  const uint64_t n = s.waits.fetch_add(1, std::memory_order_relaxed);
+  if ((n & 63) == 63) {
+    __imp__sub_82943548(ctx, base);  // the original yield, with its title-termination check
+    return;
+  }
+  const int64_t start = NowNs();
+  rex::thread::Sleep(std::chrono::microseconds(100));
+  const int64_t now = NowNs();
+  const uint64_t ns = uint64_t(now - start);
+  s.slept_ns.fetch_add(ns, std::memory_order_relaxed);
+  if (ns > s.max_ns.load(std::memory_order_relaxed)) s.max_ns.store(ns, std::memory_order_relaxed);
+  if (side == 0) MaybeReport(now);
+  ctx.r3.u64 = 0;  // SleepEx's return value
+}
diff --git a/src/lod_bias_hook.cpp b/src/lod_bias_hook.cpp
new file mode 100644
index 0000000..fb2df74
--- /dev/null
+++ b/src/lod_bias_hook.cpp
@@ -0,0 +1,26 @@
+// Switch: optional object detail trim for the scene view (quality for speed).
+//
+// sub_82586908 (the Render thread's per-instance test, called once per scene object per view) asks
+// sub_82586288 for the object's projected size in pixels (focal * radius / (distance - radius), 0 =
+// behind the view plane). It then drops objects under ~18 px (23/32 with some flags and detail
+// levels), picks the model/LOD with the same thresholds and skips anything <= 1. Scaling that size by
+// carbon_lod_bias < 1 makes objects look smaller to the test: far small props leave the scene
+// sooner and lower LODs start sooner, so a populated street submits fewer draws. 1.0 = the game's
+// own choice (default). sub_82586288 has a single caller (sub_82586908).
+
+#include <rex/cvar.h>
+
+#include "../generated/default/nfscarbon_pch.h"
+
+REXCVAR_DEFINE_DOUBLE(carbon_lod_bias, 1.0, "CarbonPerf",
+                      "Scale of the projected object size the scene visibility test sees (1.0 = game default, "
+                      "0.8 = objects drop out / switch to lower detail sooner, fewer draws)")
+    .range(0.3, 1.0);
+
+extern "C" void __imp__sub_82586288(PPCContext& __restrict ctx, uint8_t* base);
+
+extern "C" REX_FUNC(sub_82586288) {
+  __imp__sub_82586288(ctx, base);
+  const double bias = REXCVAR_GET(carbon_lod_bias);
+  if (bias < 1.0) ctx.r3.u64 = uint32_t(int32_t(double(ctx.r3.s32) * bias));
+}
