diff --git a/renderer/src/texture_binding_cache.h b/renderer/src/texture_binding_cache.h
new file mode 100644
index 0000000..13142e9
--- /dev/null
+++ b/renderer/src/texture_binding_cache.h
@@ -0,0 +1,66 @@
+#pragma once
+
+#include <rex/ui/vulkan/api.h>
+
+#include "shader_translator.h"
+
+namespace carbon::gpu {
+
+// Same-frame only: a resolve or descriptor-pool reset invalidates both stages.
+class TextureBindingCache {
+ public:
+  void Reset() { set_ = VK_NULL_HANDLE; }
+
+  VkDescriptorSet Find(const RegisterFile& regs, const TranslatedShader& shader,
+                       DrawConstants& constants) const {
+    if (!set_ || shader_ != &shader) return VK_NULL_HANDLE;
+    for (const TextureBinding& binding : shader.textures) {
+      const uint32_t index = binding.fetch_index;
+      assert(index < 32);
+      if (std::memcmp(fetch_[index], &regs.values[kRegFetchConstants + index * 6],
+                      sizeof(fetch_[index]))) {
+        return VK_NULL_HANDLE;
+      }
+    }
+    for (const TextureBinding& binding : shader.textures) {
+      const uint32_t index = binding.fetch_index;
+      std::memcpy(&constants.tex_size[index * 4], params_[index].size,
+                   sizeof(params_[index].size));
+      std::memcpy(&constants.tex_info[index * 4], params_[index].info,
+                   sizeof(params_[index].info));
+      std::memcpy(&constants.tex_uv[index * 4], params_[index].uv,
+                   sizeof(params_[index].uv));
+    }
+    return set_;
+  }
+
+  void Store(const RegisterFile& regs, const TranslatedShader& shader,
+             const DrawConstants& constants, VkDescriptorSet set) {
+    shader_ = &shader;
+    set_ = set;
+    for (const TextureBinding& binding : shader.textures) {
+      const uint32_t index = binding.fetch_index;
+      assert(index < 32);
+      std::memcpy(fetch_[index], &regs.values[kRegFetchConstants + index * 6],
+                   sizeof(fetch_[index]));
+      std::memcpy(params_[index].size, &constants.tex_size[index * 4],
+                   sizeof(params_[index].size));
+      std::memcpy(params_[index].info, &constants.tex_info[index * 4],
+                   sizeof(params_[index].info));
+      std::memcpy(params_[index].uv, &constants.tex_uv[index * 4],
+                   sizeof(params_[index].uv));
+    }
+  }
+
+ private:
+  const TranslatedShader* shader_ = nullptr;
+  VkDescriptorSet set_ = VK_NULL_HANDLE;
+  uint32_t fetch_[32][6] = {};
+  struct Params {
+    float size[4];
+    uint32_t info[3];
+    float uv[2];
+  } params_[32] = {};
+};
+
+}  // namespace carbon::gpu
