diff --git a/renderer/src/command_recorder.h b/renderer/src/command_recorder.h
new file mode 100644
index 0000000..705a010
--- /dev/null
+++ b/renderer/src/command_recorder.h
@@ -0,0 +1,676 @@
+#pragma once
+
+#include <atomic>
+#include <cassert>
+#include <chrono>
+#include <condition_variable>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include <type_traits>
+
+#include <rex/ui/vulkan/api.h>
+
+namespace carbon::gpu {
+
+// The vkCmd* entry points the renderer records into the frame command buffer.
+struct RecorderDispatch {
+  PFN_vkCmdPipelineBarrier PipelineBarrier = nullptr;
+  PFN_vkCmdBeginRendering BeginRendering = nullptr;
+  PFN_vkCmdEndRendering EndRendering = nullptr;
+  PFN_vkCmdWriteTimestamp WriteTimestamp = nullptr;
+  PFN_vkCmdResetQueryPool ResetQueryPool = nullptr;
+  PFN_vkCmdBindPipeline BindPipeline = nullptr;
+  PFN_vkCmdBindDescriptorSets BindDescriptorSets = nullptr;
+  PFN_vkCmdSetViewport SetViewport = nullptr;
+  PFN_vkCmdSetScissor SetScissor = nullptr;
+  PFN_vkCmdSetDepthBias SetDepthBias = nullptr;
+  PFN_vkCmdSetBlendConstants SetBlendConstants = nullptr;
+  PFN_vkCmdSetStencilReference SetStencilReference = nullptr;
+  PFN_vkCmdSetStencilCompareMask SetStencilCompareMask = nullptr;
+  PFN_vkCmdSetStencilWriteMask SetStencilWriteMask = nullptr;
+  PFN_vkCmdBindIndexBuffer BindIndexBuffer = nullptr;
+  PFN_vkCmdDraw Draw = nullptr;
+  PFN_vkCmdDrawIndexed DrawIndexed = nullptr;
+  PFN_vkCmdPushConstants PushConstants = nullptr;
+  PFN_vkCmdClearColorImage ClearColorImage = nullptr;
+  PFN_vkCmdClearAttachments ClearAttachments = nullptr;
+  PFN_vkCmdCopyImage CopyImage = nullptr;
+  PFN_vkCmdCopyImageToBuffer CopyImageToBuffer = nullptr;
+};
+
+// Records the frame command buffer either immediately on the calling (CP) thread,
+// or by value into a single-producer/single-consumer ring that one worker thread
+// replays in the same order. Only the producer calls the public methods; between
+// BeginFrame and EndFrame nothing else may record into the target buffer.
+class CommandRecorder {
+ public:
+  static constexpr size_t kRingBytes = size_t(4) << 20;
+  static constexpr size_t kWakeBytes = size_t(8) << 10;  // worker wake-up batch
+  static constexpr uint32_t kMaxPushConstantBytes = 128;
+
+  struct Stats {
+    uint64_t records = 0, wakes = 0, busy_ns = 0, backpressure_waits = 0;
+  };
+
+  CommandRecorder() = default;
+  CommandRecorder(const CommandRecorder&) = delete;
+  CommandRecorder& operator=(const CommandRecorder&) = delete;
+  ~CommandRecorder() { Stop(); }
+
+  // `on_worker_start` runs first on the worker thread (naming, priority).
+  void Start(const RecorderDispatch& dispatch, bool threaded,
+             std::function<void()> on_worker_start = {}) {
+    Stop();
+    dispatch_ = dispatch;
+    threaded_ = threaded;
+    write_ = 0;
+    published_.store(0, std::memory_order_relaxed);
+    consumed_.store(0, std::memory_order_relaxed);
+    stop_ = force_ = false;
+    if (threaded_) {
+      if (!ring_) ring_.reset(new uint8_t[kRingBytes]);
+      worker_ = std::thread([this, init = std::move(on_worker_start)]() {
+        if (init) init();
+        WorkerMain();
+      });
+    }
+  }
+
+  // Replays everything still queued, then joins the worker. Safe to call twice; later
+  // commands of an open frame are then recorded immediately, after the replayed ones.
+  void Stop() {
+    if (worker_.joinable()) {
+      Publish(true);
+      {
+        std::lock_guard<std::mutex> lock(mutex_);
+        stop_ = true;
+      }
+      work_cv_.notify_one();
+      worker_.join();
+    }
+    threaded_ = false;
+  }
+
+  bool threaded() const { return threaded_; }
+  // The frame command buffer between BeginFrame and EndFrame, else VK_NULL_HANDLE.
+  VkCommandBuffer target() const { return target_; }
+
+  // The buffer must already be in the recording state and the worker idle (drained).
+  void BeginFrame(VkCommandBuffer cb) {
+    target_ = cb;
+    if (threaded_) Push(Op::kTarget, cb);
+  }
+
+  // Waits until the worker has replayed everything; the buffer can then be ended.
+  // Returns the producer's wall seconds spent waiting.
+  double EndFrame() {
+    const double waited = Drain();
+    target_ = VK_NULL_HANDLE;
+    return waited;
+  }
+
+  double Drain() {
+    if (!threaded_ || consumed_.load(std::memory_order_acquire) == write_) return 0.0;
+    const auto start = std::chrono::steady_clock::now();
+    producer_waiting_.store(true, std::memory_order_seq_cst);
+    {
+      std::unique_lock<std::mutex> lock(mutex_);
+      force_ = true;
+      work_cv_.notify_one();
+      idle_cv_.wait(lock, [&] { return consumed_.load(std::memory_order_seq_cst) == write_; });
+      force_ = false;
+    }
+    producer_waiting_.store(false, std::memory_order_relaxed);
+    return std::chrono::duration<double>(std::chrono::steady_clock::now() - start).count();
+  }
+
+  // Relaxed snapshot; counters can straddle a report boundary by one batch.
+  Stats TakeStats() {
+    Stats s;
+    s.records = records_.exchange(0, std::memory_order_relaxed);
+    s.wakes = wakes_.exchange(0, std::memory_order_relaxed);
+    s.busy_ns = busy_ns_.exchange(0, std::memory_order_relaxed);
+    s.backpressure_waits = backpressure_waits_;
+    backpressure_waits_ = 0;
+    return s;
+  }
+
+  // ---- Commands (same arguments as the vkCmd* they replace, minus the buffer) ----
+  void PipelineBarrier(VkPipelineStageFlags src, VkPipelineStageFlags dst,
+                       const VkImageMemoryBarrier& barrier) {
+    assert(!barrier.pNext);
+    if (!threaded_) {
+      dispatch_.PipelineBarrier(target_, src, dst, 0, 0, nullptr, 0, nullptr, 1, &barrier);
+      return;
+    }
+    Push(Op::kBarrier, BarrierRecord{src, dst, barrier});
+  }
+
+  void BeginRendering(const VkRenderingInfo& info) {
+    assert(!info.pNext && info.colorAttachmentCount <= 4);
+    if (!threaded_) {
+      dispatch_.BeginRendering(target_, &info);
+      return;
+    }
+    RenderingRecord r = {};
+    r.flags = info.flags;
+    r.area = info.renderArea;
+    r.layer_count = info.layerCount;
+    r.view_mask = info.viewMask;
+    r.color_count = info.colorAttachmentCount;
+    for (uint32_t i = 0; i < r.color_count; ++i) r.color[i] = info.pColorAttachments[i];
+    if (info.pDepthAttachment) {
+      r.has_depth = 1;
+      r.depth = *info.pDepthAttachment;
+    }
+    if (info.pStencilAttachment) {
+      r.has_stencil = 1;
+      r.stencil = *info.pStencilAttachment;
+    }
+    Push(Op::kBeginRendering, r);
+  }
+
+  void EndRendering() {
+    if (!threaded_) {
+      dispatch_.EndRendering(target_);
+      return;
+    }
+    Push(Op::kEndRendering, uint64_t(0));
+  }
+
+  void WriteTimestamp(VkPipelineStageFlagBits stage, VkQueryPool pool, uint32_t query) {
+    if (!threaded_) {
+      dispatch_.WriteTimestamp(target_, stage, pool, query);
+      return;
+    }
+    Push(Op::kTimestamp, TimestampRecord{stage, query, pool});
+  }
+
+  void ResetQueryPool(VkQueryPool pool, uint32_t first, uint32_t count) {
+    if (!threaded_) {
+      dispatch_.ResetQueryPool(target_, pool, first, count);
+      return;
+    }
+    Push(Op::kResetQueryPool, ResetQueryRecord{pool, first, count});
+  }
+
+  void BindPipeline(VkPipelineBindPoint point, VkPipeline pipeline) {
+    if (!threaded_) {
+      dispatch_.BindPipeline(target_, point, pipeline);
+      return;
+    }
+    Push(Op::kBindPipeline, BindPipelineRecord{point, pipeline});
+  }
+
+  void BindDescriptorSets(VkPipelineBindPoint point, VkPipelineLayout layout, uint32_t first,
+                          uint32_t count, const VkDescriptorSet* sets, uint32_t dynamic_count,
+                          const uint32_t* dynamic_offsets) {
+    assert(count <= 3 && dynamic_count <= 11);
+    if (!threaded_) {
+      dispatch_.BindDescriptorSets(target_, point, layout, first, count, sets, dynamic_count,
+                                   dynamic_offsets);
+      return;
+    }
+    BindSetsRecord r = {};
+    r.point = point;
+    r.first = first;
+    r.count = count;
+    r.dynamic_count = dynamic_count;
+    r.layout = layout;
+    for (uint32_t i = 0; i < count; ++i) r.sets[i] = sets[i];
+    for (uint32_t i = 0; i < dynamic_count; ++i) r.dynamic[i] = dynamic_offsets[i];
+    Push(Op::kBindDescriptorSets, r);
+  }
+
+  void SetViewport(const VkViewport& viewport) {
+    if (!threaded_) {
+      dispatch_.SetViewport(target_, 0, 1, &viewport);
+      return;
+    }
+    Push(Op::kViewport, viewport);
+  }
+
+  void SetScissor(const VkRect2D& scissor) {
+    if (!threaded_) {
+      dispatch_.SetScissor(target_, 0, 1, &scissor);
+      return;
+    }
+    Push(Op::kScissor, scissor);
+  }
+
+  void SetDepthBias(float constant, float clamp, float slope) {
+    if (!threaded_) {
+      dispatch_.SetDepthBias(target_, constant, clamp, slope);
+      return;
+    }
+    Push(Op::kDepthBias, DepthBiasRecord{constant, clamp, slope});
+  }
+
+  void SetBlendConstants(const float constants[4]) {
+    if (!threaded_) {
+      dispatch_.SetBlendConstants(target_, constants);
+      return;
+    }
+    BlendRecord r;
+    std::memcpy(r.constants, constants, sizeof(r.constants));
+    Push(Op::kBlend, r);
+  }
+
+  void SetStencilReference(VkStencilFaceFlags face, uint32_t value) {
+    Stencil(Op::kStencilReference, dispatch_.SetStencilReference, face, value);
+  }
+  void SetStencilCompareMask(VkStencilFaceFlags face, uint32_t value) {
+    Stencil(Op::kStencilCompare, dispatch_.SetStencilCompareMask, face, value);
+  }
+  void SetStencilWriteMask(VkStencilFaceFlags face, uint32_t value) {
+    Stencil(Op::kStencilWrite, dispatch_.SetStencilWriteMask, face, value);
+  }
+
+  void BindIndexBuffer(VkBuffer buffer, VkDeviceSize offset, VkIndexType type) {
+    if (!threaded_) {
+      dispatch_.BindIndexBuffer(target_, buffer, offset, type);
+      return;
+    }
+    Push(Op::kBindIndexBuffer, IndexBufferRecord{buffer, offset, type});
+  }
+
+  void Draw(uint32_t vertices, uint32_t instances, uint32_t first_vertex, uint32_t first_instance) {
+    if (!threaded_) {
+      dispatch_.Draw(target_, vertices, instances, first_vertex, first_instance);
+      return;
+    }
+    Push(Op::kDraw, DrawRecord{vertices, instances, first_vertex, first_instance});
+  }
+
+  void DrawIndexed(uint32_t indices, uint32_t instances, uint32_t first_index, int32_t vertex_offset,
+                   uint32_t first_instance) {
+    if (!threaded_) {
+      dispatch_.DrawIndexed(target_, indices, instances, first_index, vertex_offset, first_instance);
+      return;
+    }
+    Push(Op::kDrawIndexed,
+         DrawIndexedRecord{indices, instances, first_index, vertex_offset, first_instance});
+  }
+
+  void PushConstants(VkPipelineLayout layout, VkShaderStageFlags stages, uint32_t offset,
+                     uint32_t size, const void* data) {
+    assert(size <= kMaxPushConstantBytes);
+    if (!threaded_) {
+      dispatch_.PushConstants(target_, layout, stages, offset, size, data);
+      return;
+    }
+    PushConstantsRecord r = {};
+    r.layout = layout;
+    r.stages = stages;
+    r.offset = offset;
+    r.size = size;
+    std::memcpy(r.data, data, size);
+    Push(Op::kPushConstants, r);
+  }
+
+  void ClearColorImage(VkImage image, VkImageLayout layout, const VkClearColorValue& color,
+                       const VkImageSubresourceRange& range) {
+    if (!threaded_) {
+      dispatch_.ClearColorImage(target_, image, layout, &color, 1, &range);
+      return;
+    }
+    Push(Op::kClearColorImage, ClearColorRecord{image, layout, color, range});
+  }
+
+  void ClearAttachments(const VkClearAttachment& attachment, const VkClearRect& rect) {
+    if (!threaded_) {
+      dispatch_.ClearAttachments(target_, 1, &attachment, 1, &rect);
+      return;
+    }
+    Push(Op::kClearAttachments, ClearAttachmentsRecord{attachment, rect});
+  }
+
+  void CopyImage(VkImage src, VkImageLayout src_layout, VkImage dst, VkImageLayout dst_layout,
+                 const VkImageCopy& region) {
+    if (!threaded_) {
+      dispatch_.CopyImage(target_, src, src_layout, dst, dst_layout, 1, &region);
+      return;
+    }
+    Push(Op::kCopyImage, CopyImageRecord{src, dst, src_layout, dst_layout, region});
+  }
+
+  void CopyImageToBuffer(VkImage src, VkImageLayout layout, VkBuffer dst,
+                         const VkBufferImageCopy& region) {
+    if (!threaded_) {
+      dispatch_.CopyImageToBuffer(target_, src, layout, dst, 1, &region);
+      return;
+    }
+    Push(Op::kCopyImageToBuffer, CopyToBufferRecord{src, dst, layout, region});
+  }
+
+ private:
+  enum class Op : uint32_t {
+    kWrap, kTarget, kBarrier, kBeginRendering, kEndRendering, kTimestamp, kResetQueryPool,
+    kBindPipeline, kBindDescriptorSets, kViewport, kScissor, kDepthBias, kBlend,
+    kStencilReference, kStencilCompare, kStencilWrite, kBindIndexBuffer, kDraw, kDrawIndexed,
+    kPushConstants, kClearColorImage, kClearAttachments, kCopyImage, kCopyImageToBuffer,
+  };
+  struct Header {
+    Op op;
+    uint32_t size;  // whole record, multiple of 8
+  };
+  struct BarrierRecord {
+    VkPipelineStageFlags src, dst;
+    VkImageMemoryBarrier barrier;
+  };
+  struct RenderingRecord {
+    VkRenderingFlags flags;
+    VkRect2D area;
+    uint32_t layer_count, view_mask, color_count, has_depth, has_stencil;
+    VkRenderingAttachmentInfo color[4];
+    VkRenderingAttachmentInfo depth, stencil;
+  };
+  struct TimestampRecord {
+    VkPipelineStageFlagBits stage;
+    uint32_t query;
+    VkQueryPool pool;
+  };
+  struct ResetQueryRecord {
+    VkQueryPool pool;
+    uint32_t first, count;
+  };
+  struct BindPipelineRecord {
+    VkPipelineBindPoint point;
+    VkPipeline pipeline;
+  };
+  struct BindSetsRecord {
+    VkPipelineBindPoint point;
+    uint32_t first, count, dynamic_count;
+    VkPipelineLayout layout;
+    VkDescriptorSet sets[3];
+    uint32_t dynamic[11];  // set 0: bindings 0-2 + 2 x 4 constant blocks
+  };
+  struct DepthBiasRecord {
+    float constant, clamp, slope;
+  };
+  struct BlendRecord {
+    float constants[4];
+  };
+  struct StencilRecord {
+    VkStencilFaceFlags face;
+    uint32_t value;
+  };
+  struct IndexBufferRecord {
+    VkBuffer buffer;
+    VkDeviceSize offset;
+    VkIndexType type;
+  };
+  struct DrawRecord {
+    uint32_t vertices, instances, first_vertex, first_instance;
+  };
+  struct DrawIndexedRecord {
+    uint32_t indices, instances, first_index;
+    int32_t vertex_offset;
+    uint32_t first_instance;
+  };
+  struct PushConstantsRecord {
+    VkPipelineLayout layout;
+    VkShaderStageFlags stages;
+    uint32_t offset, size;
+    uint8_t data[kMaxPushConstantBytes];
+  };
+  struct ClearColorRecord {
+    VkImage image;
+    VkImageLayout layout;
+    VkClearColorValue color;
+    VkImageSubresourceRange range;
+  };
+  struct ClearAttachmentsRecord {
+    VkClearAttachment attachment;
+    VkClearRect rect;
+  };
+  struct CopyImageRecord {
+    VkImage src, dst;
+    VkImageLayout src_layout, dst_layout;
+    VkImageCopy region;
+  };
+  struct CopyToBufferRecord {
+    VkImage src;
+    VkBuffer dst;
+    VkImageLayout layout;
+    VkBufferImageCopy region;
+  };
+
+  static constexpr uint32_t RecordSize(size_t payload) {
+    return uint32_t((sizeof(Header) + payload + 7) & ~size_t(7));
+  }
+
+  // The three stencil entry points share one signature.
+  void Stencil(Op op, PFN_vkCmdSetStencilReference fn, VkStencilFaceFlags face, uint32_t value) {
+    if (!threaded_) {
+      fn(target_, face, value);
+      return;
+    }
+    Push(op, StencilRecord{face, value});
+  }
+
+  template <typename T>
+  void Push(Op op, const T& payload) {
+    static_assert(std::is_trivially_copyable_v<T>);
+    constexpr uint32_t size = RecordSize(sizeof(T));
+    static_assert(size <= kWakeBytes);
+    size_t pos = size_t(write_ % kRingBytes);
+    if (pos + size > kRingBytes) {
+      // Pad to the end of the ring; records never straddle the wrap point.
+      const uint32_t pad = uint32_t(kRingBytes - pos);
+      WaitForSpace(pad);
+      const Header wrap = {Op::kWrap, pad};
+      std::memcpy(ring_.get() + pos, &wrap, sizeof(wrap));
+      write_ += pad;
+      pos = 0;
+    }
+    WaitForSpace(size);
+    const Header header = {op, size};
+    std::memcpy(ring_.get() + pos, &header, sizeof(header));
+    std::memcpy(ring_.get() + pos + sizeof(header), &payload, sizeof(T));
+    write_ += size;
+    Publish(false);
+  }
+
+  // Publishes written records; wakes a sleeping worker only per batch or when forced.
+  void Publish(bool force) {
+    published_.store(write_, std::memory_order_seq_cst);
+    if (!sleeping_.load(std::memory_order_seq_cst)) return;
+    if (!force && write_ - consumed_.load(std::memory_order_relaxed) < kWakeBytes) return;
+    std::lock_guard<std::mutex> lock(mutex_);
+    work_cv_.notify_one();
+  }
+
+  void WaitForSpace(size_t bytes) {
+    if (write_ + bytes - consumed_.load(std::memory_order_acquire) <= kRingBytes) return;
+    ++backpressure_waits_;
+    producer_waiting_.store(true, std::memory_order_seq_cst);
+    {
+      std::unique_lock<std::mutex> lock(mutex_);
+      force_ = true;
+      work_cv_.notify_one();
+      idle_cv_.wait(lock, [&] {
+        return write_ + bytes - consumed_.load(std::memory_order_seq_cst) <= kRingBytes;
+      });
+      force_ = false;
+    }
+    producer_waiting_.store(false, std::memory_order_relaxed);
+  }
+
+  void WorkerMain() {
+    uint64_t read = consumed_.load(std::memory_order_relaxed);
+    VkCommandBuffer cb = VK_NULL_HANDLE;
+    for (;;) {
+      const uint64_t available = published_.load(std::memory_order_acquire);
+      if (available == read) {
+        std::unique_lock<std::mutex> lock(mutex_);
+        sleeping_.store(true, std::memory_order_seq_cst);
+        work_cv_.wait(lock, [&] {
+          const uint64_t pending = published_.load(std::memory_order_seq_cst) - read;
+          return stop_ || pending >= kWakeBytes || (force_ && pending);
+        });
+        sleeping_.store(false, std::memory_order_relaxed);
+        if (stop_ && published_.load(std::memory_order_seq_cst) == read) return;
+        wakes_.fetch_add(1, std::memory_order_relaxed);
+        continue;
+      }
+      const auto start = std::chrono::steady_clock::now();
+      uint64_t records = 0;
+      while (read != available) {
+        const uint8_t* at = ring_.get() + size_t(read % kRingBytes);
+        Header header;
+        std::memcpy(&header, at, sizeof(header));
+        Execute(header.op, at + sizeof(Header), cb);
+        read += header.size;
+        records += header.op != Op::kWrap;
+      }
+      consumed_.store(read, std::memory_order_seq_cst);
+      records_.fetch_add(records, std::memory_order_relaxed);
+      busy_ns_.fetch_add(uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                      std::chrono::steady_clock::now() - start)
+                                      .count()),
+                         std::memory_order_relaxed);
+      if (producer_waiting_.load(std::memory_order_seq_cst)) {
+        std::lock_guard<std::mutex> lock(mutex_);
+        idle_cv_.notify_all();
+      }
+    }
+  }
+
+  template <typename T>
+  static T Read(const uint8_t* at) {
+    T value;
+    std::memcpy(&value, at, sizeof(T));
+    return value;
+  }
+
+  void Execute(Op op, const uint8_t* at, VkCommandBuffer& cb) const {
+    const RecorderDispatch& d = dispatch_;
+    switch (op) {
+      case Op::kWrap:
+        break;
+      case Op::kTarget:
+        cb = Read<VkCommandBuffer>(at);
+        break;
+      case Op::kBarrier: {
+        const auto r = Read<BarrierRecord>(at);
+        d.PipelineBarrier(cb, r.src, r.dst, 0, 0, nullptr, 0, nullptr, 1, &r.barrier);
+      } break;
+      case Op::kBeginRendering: {
+        const auto r = Read<RenderingRecord>(at);
+        VkRenderingInfo info = {};
+        info.sType = VK_STRUCTURE_TYPE_RENDERING_INFO;
+        info.flags = r.flags;
+        info.renderArea = r.area;
+        info.layerCount = r.layer_count;
+        info.viewMask = r.view_mask;
+        info.colorAttachmentCount = r.color_count;
+        info.pColorAttachments = r.color_count ? r.color : nullptr;
+        info.pDepthAttachment = r.has_depth ? &r.depth : nullptr;
+        info.pStencilAttachment = r.has_stencil ? &r.stencil : nullptr;
+        d.BeginRendering(cb, &info);
+      } break;
+      case Op::kEndRendering:
+        d.EndRendering(cb);
+        break;
+      case Op::kTimestamp: {
+        const auto r = Read<TimestampRecord>(at);
+        d.WriteTimestamp(cb, r.stage, r.pool, r.query);
+      } break;
+      case Op::kResetQueryPool: {
+        const auto r = Read<ResetQueryRecord>(at);
+        d.ResetQueryPool(cb, r.pool, r.first, r.count);
+      } break;
+      case Op::kBindPipeline: {
+        const auto r = Read<BindPipelineRecord>(at);
+        d.BindPipeline(cb, r.point, r.pipeline);
+      } break;
+      case Op::kBindDescriptorSets: {
+        const auto r = Read<BindSetsRecord>(at);
+        d.BindDescriptorSets(cb, r.point, r.layout, r.first, r.count, r.sets, r.dynamic_count,
+                             r.dynamic_count ? r.dynamic : nullptr);
+      } break;
+      case Op::kViewport: {
+        const auto r = Read<VkViewport>(at);
+        d.SetViewport(cb, 0, 1, &r);
+      } break;
+      case Op::kScissor: {
+        const auto r = Read<VkRect2D>(at);
+        d.SetScissor(cb, 0, 1, &r);
+      } break;
+      case Op::kDepthBias: {
+        const auto r = Read<DepthBiasRecord>(at);
+        d.SetDepthBias(cb, r.constant, r.clamp, r.slope);
+      } break;
+      case Op::kBlend: {
+        const auto r = Read<BlendRecord>(at);
+        d.SetBlendConstants(cb, r.constants);
+      } break;
+      case Op::kStencilReference: {
+        const auto r = Read<StencilRecord>(at);
+        d.SetStencilReference(cb, r.face, r.value);
+      } break;
+      case Op::kStencilCompare: {
+        const auto r = Read<StencilRecord>(at);
+        d.SetStencilCompareMask(cb, r.face, r.value);
+      } break;
+      case Op::kStencilWrite: {
+        const auto r = Read<StencilRecord>(at);
+        d.SetStencilWriteMask(cb, r.face, r.value);
+      } break;
+      case Op::kBindIndexBuffer: {
+        const auto r = Read<IndexBufferRecord>(at);
+        d.BindIndexBuffer(cb, r.buffer, r.offset, r.type);
+      } break;
+      case Op::kDraw: {
+        const auto r = Read<DrawRecord>(at);
+        d.Draw(cb, r.vertices, r.instances, r.first_vertex, r.first_instance);
+      } break;
+      case Op::kDrawIndexed: {
+        const auto r = Read<DrawIndexedRecord>(at);
+        d.DrawIndexed(cb, r.indices, r.instances, r.first_index, r.vertex_offset, r.first_instance);
+      } break;
+      case Op::kPushConstants: {
+        const auto r = Read<PushConstantsRecord>(at);
+        d.PushConstants(cb, r.layout, r.stages, r.offset, r.size, r.data);
+      } break;
+      case Op::kClearColorImage: {
+        const auto r = Read<ClearColorRecord>(at);
+        d.ClearColorImage(cb, r.image, r.layout, &r.color, 1, &r.range);
+      } break;
+      case Op::kClearAttachments: {
+        const auto r = Read<ClearAttachmentsRecord>(at);
+        d.ClearAttachments(cb, 1, &r.attachment, 1, &r.rect);
+      } break;
+      case Op::kCopyImage: {
+        const auto r = Read<CopyImageRecord>(at);
+        d.CopyImage(cb, r.src, r.src_layout, r.dst, r.dst_layout, 1, &r.region);
+      } break;
+      case Op::kCopyImageToBuffer: {
+        const auto r = Read<CopyToBufferRecord>(at);
+        d.CopyImageToBuffer(cb, r.src, r.layout, r.dst, 1, &r.region);
+      } break;
+    }
+  }
+
+  RecorderDispatch dispatch_;
+  bool threaded_ = false;
+  VkCommandBuffer target_ = VK_NULL_HANDLE;
+  std::unique_ptr<uint8_t[]> ring_;
+  uint64_t write_ = 0;  // producer only
+  uint64_t backpressure_waits_ = 0;  // producer only
+  std::atomic<uint64_t> published_{0}, consumed_{0};
+  std::atomic<bool> sleeping_{false}, producer_waiting_{false};
+  std::atomic<uint64_t> records_{0}, wakes_{0}, busy_ns_{0};
+  std::mutex mutex_;
+  std::condition_variable work_cv_, idle_cv_;
+  bool stop_ = false, force_ = false;  // guarded by mutex_
+  std::thread worker_;
+};
+
+}  // namespace carbon::gpu
diff --git a/renderer/src/constant_batch.h b/renderer/src/constant_batch.h
new file mode 100644
index 0000000..3b66c82
--- /dev/null
+++ b/renderer/src/constant_batch.h
@@ -0,0 +1,47 @@
+#pragma once
+
+#include <algorithm>
+
+#include "gpu_common.h"
+
+namespace carbon::gpu {
+
+struct FloatConstantWriteCounts {
+  uint32_t written[2] = {};
+  uint32_t changed[2] = {};
+  uint32_t changed_blocks[2] = {};  // bit b: a word of 64-constant block b changed (constant_blocks.h)
+};
+
+// Float constants have no register side effects; notify each stage after the packet.
+inline bool TryWriteFloatConstantsBE(RegisterFile& regs, uint32_t index,
+                                     const uint32_t* guest_be, uint32_t count,
+                                     FloatConstantWriteCounts& counts) {
+  if (index < kRegFloatConstants || index >= kRegFetchConstants ||
+      count > kRegFetchConstants - index) {
+    return false;
+  }
+  counts = {};
+  while (count) {
+    const uint32_t offset = index - kRegFloatConstants;
+    const uint32_t stage = offset / 1024;
+    const uint32_t n = std::min(count, 1024 - (offset % 1024));
+    uint32_t changed = 0, blocks = 0;
+    uint32_t* dst = &regs.values[index];
+    for (uint32_t i = 0; i < n; ++i) {
+      const uint32_t value = ByteSwap32(guest_be[i]);
+      const uint32_t differs = dst[i] != value;
+      changed += differs;
+      blocks |= differs << (((offset % 1024) + i) >> 8);
+      dst[i] = value;
+    }
+    counts.written[stage] = n;
+    counts.changed[stage] = changed;
+    counts.changed_blocks[stage] = blocks;
+    count -= n;
+    index += n;
+    guest_be += n;
+  }
+  return true;
+}
+
+}  // namespace carbon::gpu
diff --git a/renderer/src/constant_blocks.h b/renderer/src/constant_blocks.h
new file mode 100644
index 0000000..41f4948
--- /dev/null
+++ b/renderer/src/constant_blocks.h
@@ -0,0 +1,54 @@
+#pragma once
+
+// Float constants in 1 KB blocks (carbon_gpu_constant_blocks). Each stage's 256 constants are also bound
+// as four 64-constant uniform blocks (set 0 bindings 5 and 6), so a draw re-uploads only the blocks whose
+// constants changed instead of the whole range (b856 capture: memmove 10% of the CP thread, while 73% of
+// the constant words the game writes are unchanged). Shaders that index constants relatively (a0/aL)
+// keep the single 4 KB block: indexing across the block array is not guaranteed to be uniform.
+
+#include <cstdint>
+#include <string>
+#include <string_view>
+
+namespace carbon::gpu {
+
+constexpr uint32_t kConstantsPerBlock = 64;
+constexpr uint32_t kConstantBlocks = 4;
+constexpr uint32_t kConstantBlockBytes = kConstantsPerBlock * 16;
+
+// Blocks a shader reads, from its highest constant index + 1.
+constexpr uint32_t ConstantBlocksUsed(uint32_t count) {
+  return count ? (1u << ((count + kConstantsPerBlock - 1) / kConstantsPerBlock)) - 1 : 0;
+}
+
+// Block of a float-constant dword offset within its stage (1024 dwords = 256 constants).
+constexpr uint32_t ConstantBlockOfDword(uint32_t stage_dword) { return (stage_dword & 1023) >> 8; }
+
+// Rewrites the translator's fixed-index reads `<full>.c[N]` into `<blocks>[N / 64].c[N % 64]`.
+// Relative reads (`<full>.c[(...`) are left alone; callers only use this for shaders without them.
+inline std::string UseConstantBlocks(std::string_view body, std::string_view full, std::string_view blocks) {
+  std::string out;
+  out.reserve(body.size() + body.size() / 8);
+  const std::string needle = std::string(full) + ".c[";
+  size_t at = 0;
+  while (true) {
+    const size_t hit = body.find(needle, at);
+    if (hit == std::string_view::npos) break;
+    size_t digits = hit + needle.size(), end = digits;
+    while (end < body.size() && body[end] >= '0' && body[end] <= '9') ++end;
+    out.append(body, at, hit - at);
+    if (end > digits && end < body.size() && body[end] == ']') {
+      const uint32_t n = uint32_t(std::stoul(std::string(body.substr(digits, end - digits))));
+      out += std::string(blocks) + "[" + std::to_string(n / kConstantsPerBlock) + "].c[" +
+             std::to_string(n % kConstantsPerBlock) + "]";
+      at = end + 1;
+    } else {
+      out.append(body, hit, needle.size());
+      at = digits;
+    }
+  }
+  out.append(body, at, std::string_view::npos);
+  return out;
+}
+
+}  // namespace carbon::gpu
diff --git a/renderer/src/descriptor_bind_batch.h b/renderer/src/descriptor_bind_batch.h
