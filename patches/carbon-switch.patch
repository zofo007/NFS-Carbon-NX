diff --git a/CMakeLists.txt b/CMakeLists.txt
index 2f69162..8862fa9 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -8,6 +8,16 @@ project(nfscarbon LANGUAGES CXX)
 set(CMAKE_CXX_STANDARD 23)
 set(CMAKE_CXX_STANDARD_REQUIRED ON)
 
+set(REXGLUE_HOST_REXGLUE_TOOL "" CACHE FILEPATH "Native host code generator for cross builds")
+if(REXGLUE_PLATFORM_SWITCH)
+    if(NOT EXISTS "${REXGLUE_HOST_REXGLUE_TOOL}")
+        message(FATAL_ERROR "Switch builds require REXGLUE_HOST_REXGLUE_TOOL (build the host SDK first)")
+    endif()
+    add_executable(rex::rexglue IMPORTED GLOBAL)
+    set_target_properties(rex::rexglue PROPERTIES
+        IMPORTED_LOCATION "${REXGLUE_HOST_REXGLUE_TOOL}")
+endif()
+
 include(generated/rexglue.cmake)
 
 # Cross-compiling (Android): codegen runs at build time, so it must execute on
@@ -23,6 +33,7 @@ endif()
 set(NFSCARBON_SOURCES
     src/main.cpp
     src/dispatch_tolerance.cpp
+    src/dlc_install.cpp
 )
 
 if(WIN32)
@@ -76,6 +87,37 @@ option(NFSCARBON_BUILD_CARBON_GPU "Build the rexgpu-carbon native renderer plugi
 if(NFSCARBON_BUILD_CARBON_GPU)
     add_subdirectory(renderer)
     add_dependencies(nfscarbon rexgpu-carbon)
+    if(REXGLUE_PLATFORM_SWITCH)
+        target_link_libraries(nfscarbon PRIVATE rexgpu-carbon)
+        target_compile_definitions(nfscarbon PRIVATE NFSCARBON_STATIC_CARBON_GPU=1)
+        target_sources(nfscarbon PRIVATE src/ring_wait_hook.cpp)
+    endif()
+endif()
+
+if(REXGLUE_PLATFORM_SWITCH)
+    # GCC spends minutes optimizing 72k startup-only registration calls; guest code stays optimized.
+    set_source_files_properties(generated/default/nfscarbon_register.cpp PROPERTIES
+        COMPILE_OPTIONS "-O0" SKIP_PRECOMPILE_HEADERS ON)
+    target_sources(nfscarbon PRIVATE src/audio_resampler_hook.cpp src/render_pass_profile_hook.cpp
+                   src/frame_handoff_hook.cpp src/audio_server_wait_hook.cpp
+                   src/switch_limits_log.cpp src/video_hook.cpp src/video_wmv3.cpp src/lod_bias_hook.cpp src/audio_mixer_diag.cpp)
+    target_link_libraries(nfscarbon PRIVATE libavcodec libavutil)
+    # NFSCARBON_ICON: 256x256 JPEG made from local game data; empty keeps the devkitPro default.
+    # Version = top heading of the workspace CHANGELOG.md, so a release bump reaches the NRO and the log.
+    set(NFSCARBON_VERSION "0.1.0-dev")
+    if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/../CHANGELOG.md")
+        file(STRINGS "${CMAKE_CURRENT_SOURCE_DIR}/../CHANGELOG.md" _nfs_heading REGEX "^## [0-9][^ ]*" LIMIT_COUNT 1)
+        if(_nfs_heading MATCHES "^## ([^ ]+)")
+            set(NFSCARBON_VERSION "${CMAKE_MATCH_1}")
+        endif()
+    endif()
+    target_compile_definitions(nfscarbon PRIVATE NFSCARBON_VERSION="${NFSCARBON_VERSION}")
+    rexglue_switch_add_nro(nfscarbon NAME "NFS Carbon NX" AUTHOR "zofo007" VERSION "${NFSCARBON_VERSION}"
+        ICON "${NFSCARBON_ICON}")
+    if(NFSCARBON_ICON)
+        # The NRO is packed after linking; relink so a new icon alone repackages it.
+        set_property(TARGET nfscarbon APPEND PROPERTY LINK_DEPENDS "${NFSCARBON_ICON}")
+    endif()
 endif()
 
 if(ANDROID)
diff --git a/generated/rexglue.cmake b/generated/rexglue.cmake
index 58a60c4..4eb8b4b 100644
--- a/generated/rexglue.cmake
+++ b/generated/rexglue.cmake
@@ -88,12 +88,16 @@ macro(rexglue_setup_target target_name)
         rexglue_apply_target_settings(${target_name}_recomp)
         rexglue_apply_recomp_settings(${target_name}_recomp
             "${REXGLUE_ENTRYPOINT_INCLUDE_DIR}/nfscarbon_pch.h")
-        add_dependencies(${target_name}_recomp nfscarbon_codegen)
+        if(TARGET nfscarbon_codegen)
+            add_dependencies(${target_name}_recomp nfscarbon_codegen)
+        endif()
         target_link_libraries(${target_name} PRIVATE
             ${target_name}_recomp)
     endif()
     # Also on the host, so a tree that has never run codegen still generates it.
-    add_dependencies(${target_name} nfscarbon_codegen)
+    if(TARGET nfscarbon_codegen)
+        add_dependencies(${target_name} nfscarbon_codegen)
+    endif()
     target_include_directories(${target_name} PRIVATE
         ${CMAKE_CURRENT_SOURCE_DIR}
         ${CMAKE_CURRENT_SOURCE_DIR}/src
@@ -114,6 +118,11 @@ endmacro()
 # codegen, including one a project assembles itself rather than taking the
 # library rexglue_setup_target() builds. The stamp comes first: the DEPFILE
 # names it.
+#
+# A cross build (Nintendo Switch) has no rexglue it could run: the tool is a
+# host program. There the generated sources must already exist, produced by
+# running codegen with a host SDK.
+if(TARGET rex::rexglue)
 add_custom_command(
     OUTPUT "${CMAKE_CURRENT_SOURCE_DIR}/generated/default/codegen.build.stamp"
            ${REXGLUE_ENTRYPOINT_GENERATED_SOURCES}
@@ -125,6 +134,11 @@ add_custom_command(
 )
 add_custom_target(nfscarbon_codegen
     DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/generated/default/codegen.build.stamp")
+elseif(NOT REXGLUE_ENTRYPOINT_GENERATED_SOURCES)
+    message(FATAL_ERROR
+        "No generated sources in generated/default and no rexglue to produce them "
+        "(cross build). Run 'rexglue codegen nfscarbon_manifest.toml' with a host SDK first.")
+endif()
 
 # Include DLL module shared library targets if codegen has generated them
 if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/generated/default/dll_targets.cmake")
diff --git a/nfscarbon_manifest.toml b/nfscarbon_manifest.toml
index 1f48a33..09affde 100644
--- a/nfscarbon_manifest.toml
+++ b/nfscarbon_manifest.toml
@@ -10,7 +10,44 @@ file_path = "game/default.xex"
 out_directory_path = "generated/default"
 includes = []
 
+# Codegen performance options, the same set the MW port uses (reference-nfsmw-nx/app/overrides.toml).
+# They must sit in [entrypoint] (where file_path is read); elsewhere the codegen ignores them silently.
+# Measured on Carbon (stack capture 23:14-23:20, d8241f094d4d): the PowerPC register save/restore
+# helpers (__savegprlr_N/__restgprlr_N) are 13-18% of the game main thread's busy time; with
+# non_volatile_as_local r14-r31 become locals and those calls disappear. cr/xer/ctr as locals let
+# the compiler keep condition, carry and count registers in host registers. Only the native
+# resampler hook touches these registers: it saves/restores r31 and writes volatile cr/xer.
+# skip_lr stays off (ring_wait_hook reads ctx.lr); non_argument_as_local stays off (r12 is the
+# base __savevmx_N receives).
+cr_as_local = true
+non_volatile_as_local = true
+xer_as_local = true
+ctr_as_local = true
+
+
 [entrypoint.functions]
+# share_registers = true (146 entries below): split-off tails, SEH handler bodies and the CRT setjmp
+# 0x8279D060 read their owner's/caller's r14-r31 (or f14-f31) on entry. With non_volatile_as_local
+# those live in the owner's locals, so unmarked they read zero (daa6540b522b crashed at boot in
+# 0x829478E4 reading the owner's r31). Marked, the owner hands them its registers through ctx
+# (MW app/overrides.toml, same mechanism). List: MW tools/lee_antes.py on the generated code, minus
+# its own share-copy lines, keeping only functions without a prologue or save helper (three hits in
+# normal functions and all vector/cr6 hits were text-order artifacts). Re-run it after regeneration.
+0x8279D060 = { share_registers = true }
+# The game's WMV decoder keeps constants in VMX128 v64-v127 across calls: 0x82B048A8 and
+# 0x82B04BF0 swap all of v64-v127 (store to one buffer, load from another) and the IDCT/motion
+# leaves below read v64/v65/v69/v72 on entry. Localized, the swapped-in values were lost and
+# 94386afe7c72 showed corrupted FMVs. All nine are leaves without save helpers. Found by an
+# assembly-level scan (PPC comments), which also confirms the 146 above.
+0x82B048A8 = { share_registers = true }
+0x82B04BF0 = { share_registers = true }
+0x828F2CD0 = { share_registers = true }
+0x828F3308 = { share_registers = true }
+0x82AE2AE0 = { share_registers = true }
+0x82AE2E88 = { share_registers = true }
+0x82AE3148 = { share_registers = true }
+0x82AE33B0 = { share_registers = true }
+0x82AE4FA0 = { share_registers = true }
