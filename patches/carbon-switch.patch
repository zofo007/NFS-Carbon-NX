+#pragma once
+
+#include <cstdint>
+#include <vulkan/vulkan_core.h>
+
+namespace carbon::gpu {
+
+// Command-thread only; ready pipelines live until the renderer/device shuts down.
+struct ReadyPipelineCache {
+  uint64_t hash = 0;
+  VkPipeline pipeline = VK_NULL_HANDLE;
+
+  VkPipeline Find(uint64_t key) const { return key == hash ? pipeline : VK_NULL_HANDLE; }
+  void Store(uint64_t key, VkPipeline ready) {
+    if (ready) {
+      hash = key;
+      pipeline = ready;
+    }
+  }
+};
+
+}  // namespace carbon::gpu
