+// The retired pool is destroyed with this frame's deferred work: every frame that used its sets is done
+// by then, and the views they name are destroyed no earlier than the frame that scheduled them.
+void Renderer::RetireTextureSets() {
+  texture_set_cache_.clear();
+  texture_sets_stale_ = false;
+  if (!texture_set_pool_) return;
+  ++stats_.texture_set_retires;
+  VkDescriptorPool pool = texture_set_pool_;
+  texture_set_pool_ = VK_NULL_HANDLE;
+  frame().deferred_destroy.push_back([this, pool]() {  // not DeferDestroy: nothing it names is a view
+    vulkan_device_->functions().vkDestroyDescriptorPool(vk_device_, pool, nullptr);
+  });
+}
