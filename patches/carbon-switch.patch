diff --git a/src/audio_resampler.h b/src/audio_resampler.h
new file mode 100644
index 0000000..247c117
--- /dev/null
+++ b/src/audio_resampler.h
@@ -0,0 +1,71 @@
+#pragma once
+
+#include "../generated/default/nfscarbon_pch.h"
+
+#include <cmath>
+
+namespace carbon::audio {
+
+// Carbon 826CB1D8: keep loop state in host registers, preserving all guest
+// accesses (including stack aliases), FP round points and final volatile state.
+// With cr/xer/non-volatile registers as codegen locals (nfscarbon_manifest.toml),
+// the original keeps cr0/cr6/xer/r31 out of ctx and saves its zero-initialized
+// local r31 into the stack slot; this does the same.
+inline void Resample(PPCContext& __restrict ctx, uint8_t* base) {
+  REX_FUNC_PROLOGUE();
+  PPCXERRegister xer{};
+  PPCCRRegister cr0{}, cr6{};
+  REX_STORE_U64(ctx.r1.u32 - 8, uint64_t(0));
+  uint64_t position = REX_LOAD_U32(ctx.r7.u32);
+  cr6.compare<int32_t>(ctx.r4.s32, 0, xer);
+  uint64_t fraction = REX_LOAD_U16(ctx.r8.u32);
+  if (cr6.gt) {
+    uint64_t destination = ctx.r6.u64;
+    uint64_t remaining = ctx.r4.u64;
+    ctx.fpscr.disableFlushMode();
+    PPCRegister bits{};
+    bits.u32 = REX_LOAD_U32(0x820C7E18u);
+    const double scale = double(bits.f32);
+    const uint64_t source = ctx.r5.u64, step = ctx.r9.u64;
+    double sample = 0, delta = 0, weight = 0;
+    uint64_t advance = 0;
+    do {
+      const uint64_t old_fraction = uint32_t(fraction);
+      const uint64_t address = uint64_t(uint32_t(position) << 2) + source;
+      fraction += step;
+      xer.ca = uint32_t(remaining) > 0;
+      --remaining;
+      cr0.compare<int32_t>(int32_t(remaining), 0, xer);
+      REX_STORE_U64(ctx.r1.u32 - 16, old_fraction);
+      bits.u32 = REX_LOAD_U32(uint32_t(address));
+      sample = double(bits.f32);
+      bits.u32 = REX_LOAD_U32(uint32_t(address) + 4);
+      const double next = double(bits.f32);
+      advance = (uint32_t(fraction) >> 16) & 0xFFFF;
+      delta = double(float(next - sample));
+      fraction &= 0xFFFF;
+      position += advance;
+      bits.u64 = REX_LOAD_U64(ctx.r1.u32 - 16);
+      weight = double(float(double(bits.s64)));
+      weight = double(float(weight * scale));
+      sample = double(float(std::fma(delta, weight, sample)));
+      bits.f32 = float(sample);
+      REX_STORE_U32(uint32_t(destination), bits.u32);
+      destination += 4;
+    } while (!cr0.eq);
+    ctx.r3.u64 = destination;
+    ctx.r4.u64 = advance;
+    ctx.r6.u64 = remaining;
+    ctx.f0.f64 = sample;
+    ctx.f11.f64 = weight;
+    ctx.f12.f64 = delta;
+    ctx.f13.f64 = scale;
+  }
+  ctx.r10.u64 = position;
+  ctx.r11.u64 = uint32_t(fraction) << 16;
+  REX_STORE_U32(ctx.r7.u32, ctx.r10.u32);
+  REX_STORE_U32(ctx.r8.u32, ctx.r11.u32);
+  (void)REX_LOAD_U64(ctx.r1.u32 - 8);  // the original reloads its local r31
+}
+
+}  // namespace carbon::audio
diff --git a/src/audio_resampler_15d0.h b/src/audio_resampler_15d0.h
new file mode 100644
index 0000000..28d2ab8
--- /dev/null
+++ b/src/audio_resampler_15d0.h
@@ -0,0 +1,62 @@
+#pragma once
+
+#include "../generated/default/nfscarbon_pch.h"
+
+#include <cmath>
+
+namespace carbon::audio {
+
+// Carbon 826D15D0: host-local loop state, unchanged guest access order and FP round points.
+inline void Resample15D0(PPCContext& __restrict ctx, uint8_t* base) {
+  REX_FUNC_PROLOGUE();
+  const uint32_t step = (ctx.r8.u32 << 16) | (ctx.r9.u32 >> 16);
+  uint64_t advance = ctx.r8.u32 << 16;
+  uint64_t position = REX_LOAD_U16(ctx.r7.u32);
+  uint64_t destination = ctx.r5.u64;
+  uint32_t remaining = ctx.r3.u32;
+  REX_STORE_U32(ctx.r7.u32, uint32_t(position));
+  if (int32_t(remaining) > 0) {
+    ctx.fpscr.disableFlushMode();
+    PPCRegister bits{};
+    bits.u32 = REX_LOAD_U32(0x820C7E18u);
+    const double scale = double(bits.f32);
+    double sample = 0, delta = 0, weight = 0;
+    do {
+      const uint64_t fraction = REX_LOAD_U32(ctx.r7.u32);
+      const uint32_t index = REX_LOAD_U32(ctx.r6.u32);
+      --remaining;
+      const uint64_t address = uint64_t(index << 2) + ctx.r4.u64;
+      REX_STORE_U64(ctx.r1.u32 - 16, fraction);
+      bits.u32 = REX_LOAD_U32(uint32_t(address));
+      sample = double(bits.f32);
+      bits.u32 = REX_LOAD_U32(uint32_t(address) + 4);
+      delta = double(float(double(bits.f32) - sample));
+      bits.u64 = REX_LOAD_U64(ctx.r1.u32 - 16);
+      weight = double(float(double(bits.s64)));
+      weight = double(float(weight * scale));
+      sample = double(float(std::fma(delta, weight, sample)));
+      bits.f32 = float(sample);
+      REX_STORE_U32(uint32_t(destination), bits.u32);
+      position = uint64_t(REX_LOAD_U32(ctx.r7.u32)) + step;
+      destination += 4;
+      advance = (uint32_t(position) >> 16) & 0xFFFF;
+      REX_STORE_U32(ctx.r7.u32, uint32_t(position));
+      position = uint64_t(REX_LOAD_U32(ctx.r6.u32)) + advance;
+      REX_STORE_U32(ctx.r6.u32, uint32_t(position));
+      REX_STORE_U16(ctx.r7.u32, uint16_t(0));
+    } while (remaining != 0);
+    ctx.r5.u64 = 0;
+    ctx.f0.f64 = sample;
+    ctx.f11.f64 = weight;
+    ctx.f12.f64 = delta;
+    ctx.f13.f64 = scale;
+  }
+  ctx.r3.u64 = step;
+  ctx.r8.u64 = advance;
+  ctx.r9.u64 = position;
+  ctx.r10.u64 = destination;
+  ctx.r11.u64 = REX_LOAD_U32(ctx.r7.u32) << 16;
+  REX_STORE_U32(ctx.r7.u32, ctx.r11.u32);
+}
+
+}  // namespace carbon::audio
