new file mode 100644
index 0000000..d2e4994
--- /dev/null
+++ b/renderer/src/cache_file.h
@@ -0,0 +1,31 @@
+#pragma once
+
+#include <filesystem>
+#include <system_error>
+
+namespace carbon::gpu {
+
+using CacheRename = void (*)(const std::filesystem::path&, const std::filesystem::path&,
+                             std::error_code&);
+
+// Cache files only: Horizon rename cannot overwrite, so replacement has a gap.
+inline void CommitCacheFile(const std::filesystem::path& temp,
+                            const std::filesystem::path& target, std::error_code& error,
+                            CacheRename rename_file = std::filesystem::rename) {
+  rename_file(temp, target, error);
+  if (error != std::errc::file_exists) {
+    return;
+  }
+  if (!std::filesystem::is_regular_file(target, error)) {
+    if (!error) {
+      error = std::make_error_code(std::errc::operation_not_permitted);
+    }
+    return;
+  }
+  std::filesystem::remove(target, error);
+  if (!error) {
+    rename_file(temp, target, error);
+  }
+}
+
+}  // namespace carbon::gpu
