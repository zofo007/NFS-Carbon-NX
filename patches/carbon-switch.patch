+VkDescriptorSet Renderer::AllocateTextureSet(VkDescriptorSetLayout layout) {
+  if (!texture_sets_across_frames_) return AllocateDescriptorSet(layout);
+  const auto& dfn = vulkan_device_->functions();
+  for (int attempt = 0; attempt < 2; ++attempt) {
+    if (!texture_set_pool_) {
+      VkDescriptorPoolSize sizes[1] = {{VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 65536}};
+      VkDescriptorPoolCreateInfo ci = {VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO};
+      ci.maxSets = 16384;
+      ci.poolSizeCount = 1;
+      ci.pPoolSizes = sizes;
+      if (dfn.vkCreateDescriptorPool(vk_device_, &ci, nullptr, &texture_set_pool_) != VK_SUCCESS) {
+        // Per-frame sets must not stay cached across frames.
+        REXGPU_WARN("[carbon-gpu] texture set pool unavailable: texture sets rebuilt every frame");
+        texture_set_pool_ = VK_NULL_HANDLE;
+        texture_set_cache_.clear();
+        texture_sets_across_frames_ = false;
+        return AllocateDescriptorSet(layout);
+      }
+    }
+    VkDescriptorSetAllocateInfo ai = {VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO};
+    ai.descriptorPool = texture_set_pool_;
+    ai.descriptorSetCount = 1;
+    ai.pSetLayouts = &layout;
+    VkDescriptorSet set = VK_NULL_HANDLE;
+    if (dfn.vkAllocateDescriptorSets(vk_device_, &ai, &set) == VK_SUCCESS) {
+      ++stats_.texture_sets_created;
+      return set;
+    }
+    RetireTextureSets();  // full: sets used earlier this frame stay valid until the pool is destroyed
+  }
+  return VK_NULL_HANDLE;
+}
