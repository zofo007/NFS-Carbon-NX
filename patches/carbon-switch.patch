diff --git a/renderer/src/draw_profile.h b/renderer/src/draw_profile.h
new file mode 100644
index 0000000..68adc00
--- /dev/null
+++ b/renderer/src/draw_profile.h
@@ -0,0 +1,57 @@
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+namespace carbon::gpu {
+
+enum class DrawStage : size_t {
+  kSetupTargets, kPipeline, kPrepare, kTextures, kIndices, kVertices, kConstants, kRecord, kCount
+};
+
+// Parts of the textures and vertices stages, timed in the same sampled draws.
+enum class DrawSubStage : size_t {
+  kTexFind, kTexLookup, kTexViews, kTexSet, kVtxArena, kVtxChunk,
+  kTexHash,  // content hashing + re-upload inside kTexLookup
+  kCount
+};
+
+struct DrawStageStats {
+  uint64_t requests = 0, samples = 0;
+  std::array<double, size_t(DrawStage::kCount)> seconds{};
+  std::array<double, size_t(DrawSubStage::kCount)> sub_seconds{};
+};
+
+// Clock is a template argument so tests can use deterministic time without runtime indirection.
+template <double (*Now)()>
+class DrawStageTimer {
+ public:
+  static constexpr uint64_t kStride = 64;
+  DrawStageTimer(DrawStageStats& stats, bool enabled, uint64_t frame)
+      : stats_(stats) {
+    // Rotate the sample phase each frame to avoid always selecting the same tiled draws.
+    sampled_ = enabled && ((stats_.requests++ + frame) & (kStride - 1)) == 0;
+    if (sampled_) {
+      ++stats_.samples;
+      last_ = Now();
+    }
+  }
+  ~DrawStageTimer() { Next(stage_); }
+  bool sampled() const { return sampled_; }
+  void Next(DrawStage stage) {
+    if (!sampled_) return;
+    const double now = Now();
+    stats_.seconds[size_t(stage_)] += now - last_;
+    last_ = now;
+    stage_ = stage;
+  }
+
+ private:
+  DrawStageStats& stats_;
+  bool sampled_ = false;
+  DrawStage stage_ = DrawStage::kSetupTargets;
+  double last_ = 0;
+};
+
+}  // namespace carbon::gpu
diff --git a/renderer/src/frame_pacing.h b/renderer/src/frame_pacing.h
new file mode 100644
index 0000000..ca86544
--- /dev/null
+++ b/renderer/src/frame_pacing.h
@@ -0,0 +1,139 @@
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <iterator>
+#include <string>
+
+#include <fmt/format.h>
+
+namespace carbon::gpu {
+
+// One command-thread frame. "Present" is the swap completion in Renderer::Swap
+// (after submit, presenter hand-off and any fps cap), not the display flip.
+struct FramePacingSample {
+  float interval_ms = 0;  // previous swap completion -> this swap completion
+  float draw_ms = 0, resolve_ms = 0, wait_ms = 0, idle_ms = 0, swap_ms = 0;
+};
+
+// Per-frame pacing for one statistics window. Add() only writes fixed storage:
+// no allocation, lock, clock read or IO. Formatting happens at the report.
+class FramePacingWindow {
+ public:
+  static constexpr uint32_t kVersion = 1;
+  static constexpr size_t kCapacity = 1024;
+  static constexpr size_t kSamplesPerLine = 128;
+  static constexpr double kVblankMs = 1000.0 / 60.0;
+  static constexpr double kBudgetMs = 1000.0 / 30.0;
+  static constexpr double kGridToleranceMs = 1.5;
+  static constexpr size_t kVblankBins = 6;  // 1, 2, 3, 4, 5, 6+ vblanks
+
+  struct Summary {
+    uint32_t frames = 0, stored = 0, over_budget = 0, on_grid = 0;
+    double p50 = 0, p95 = 0, p99 = 0, worst = 0, mean = 0;
+    std::array<uint32_t, kVblankBins> vblanks{};
+  };
+
+  // Nearest multiple of 16.667 ms (halves round up), at least one vblank. floor(x + 0.5)
+  // keeps this independent of the thread's FP rounding mode and matches the analyzer.
+  static uint32_t VblankCount(double ms) {
+    return uint32_t(std::max(1.0, std::floor(ms / kVblankMs + 0.5)));
+  }
+
+  void Add(const FramePacingSample& sample, double present_s) {
+    const double ms = sample.interval_ms;
+    if (!frames_) start_s_ = present_s - ms * 0.001;
+    end_s_ = present_s;
+    ++frames_;
+    sum_ms_ += ms;
+    worst_ms_ = std::max(worst_ms_, ms);
+    over_budget_ += ms > kBudgetMs;
+    const uint32_t vblanks = VblankCount(ms);
+    ++vblanks_[std::min<size_t>(vblanks, kVblankBins) - 1];
+    on_grid_ += std::fabs(ms - vblanks * kVblankMs) <= kGridToleranceMs;
+    if (stored_ < kCapacity) samples_[stored_++] = sample;
+  }
+
+  // Percentiles use nearest rank over stored samples: rank = ceil(permille * n / 1000).
+  Summary Summarize() {
+    Summary s;
+    s.frames = frames_;
+    s.stored = uint32_t(stored_);
+    s.over_budget = over_budget_;
+    s.on_grid = on_grid_;
+    s.worst = worst_ms_;
+    s.mean = frames_ ? sum_ms_ / frames_ : 0.0;
+    s.vblanks = vblanks_;
+    for (size_t i = 0; i < stored_; ++i) scratch_[i] = samples_[i].interval_ms;
+    std::sort(scratch_.begin(), scratch_.begin() + stored_);
+    const auto pct = [&](size_t permille) {
+      if (!stored_) return 0.0;
+      const size_t rank = std::max<size_t>(1, (permille * stored_ + 999) / 1000);
+      return double(scratch_[rank - 1]);
+    };
+    s.p50 = pct(500);
+    s.p95 = pct(950);
+    s.p99 = pct(990);
+    return s;
+  }
+
+  std::string FormatSummary() {
+    const Summary s = Summarize();
+    return fmt::format(
+        "frame pacing v{} window {}: frames {} stored {} t0 {:.4f} end {:.4f} | present interval ms "
+        "p50/p95/p99/worst {:.1f}/{:.1f}/{:.1f}/{:.1f} mean {:.2f} | over 33.3 ms {} ({:.1f}%) | "
+        "vblanks 1:{} 2:{} 3:{} 4:{} 5:{} 6+:{} on-grid {}",
+        kVersion, window_, s.frames, s.stored, frames_ ? start_s_ : 0.0, frames_ ? end_s_ : 0.0,
+        s.p50, s.p95, s.p99, s.worst, s.mean, s.over_budget,
+        s.frames ? 100.0 * s.over_budget / s.frames : 0.0, s.vblanks[0], s.vblanks[1], s.vblanks[2],
+        s.vblanks[3], s.vblanks[4], s.vblanks[5], s.on_grid);
+  }
+
+  size_t SampleLineCount() const { return (stored_ + kSamplesPerLine - 1) / kSamplesPerLine; }
+
+  // Fields per frame, in 0.1 ms units: interval/draw/resolve/wait/idle/swap.
+  std::string FormatSamples(size_t part) const {
+    std::string line = fmt::format("frame pacing samples v{} window {} part {}/{}:", kVersion,
+                                   window_, part + 1, SampleLineCount());
+    auto out = std::back_inserter(line);
+    const size_t end = std::min(stored_, (part + 1) * kSamplesPerLine);
+    for (size_t i = part * kSamplesPerLine; i < end; ++i) {
+      const FramePacingSample& f = samples_[i];
+      fmt::format_to(out, " {}/{}/{}/{}/{}/{}", Tenths(f.interval_ms), Tenths(f.draw_ms),
+                     Tenths(f.resolve_ms), Tenths(f.wait_ms), Tenths(f.idle_ms), Tenths(f.swap_ms));
+    }
+    return line;
+  }
+
+  // Starts the next window; the identifier keeps report lines matchable.
+  void Reset() {
+    ++window_;
+    frames_ = over_budget_ = on_grid_ = 0;
+    stored_ = 0;
+    sum_ms_ = worst_ms_ = start_s_ = end_s_ = 0;
+    vblanks_ = {};
+  }
+
+  uint64_t window() const { return window_; }
+  size_t stored() const { return stored_; }
+  const FramePacingSample& operator[](size_t i) const { return samples_[i]; }
+
+ private:
+  static uint32_t Tenths(float ms) {
+    const double v = std::floor(double(ms) * 10.0 + 0.5);
+    return v > 0.0 ? uint32_t(std::min(v, 4.0e9)) : 0u;
+  }
+
+  std::array<FramePacingSample, kCapacity> samples_{};
+  std::array<float, kCapacity> scratch_{};
+  size_t stored_ = 0;
+  uint64_t window_ = 0;
+  uint32_t frames_ = 0, over_budget_ = 0, on_grid_ = 0;
+  double sum_ms_ = 0, worst_ms_ = 0, start_s_ = 0, end_s_ = 0;
+  std::array<uint32_t, kVblankBins> vblanks_{};
+};
+
+}  // namespace carbon::gpu
